@model IEnumerable<Application.DTOs.AuditLogDto>

@{
    ViewData["Title"] = "System Audit Logs & Monitoring";
    var selectedModule = ViewBag.SelectedModule as string;
    var searchTerm = ViewBag.SearchTerm as string;
}

<div class="d-flex flex-column gap-4">
    <!-- Header Banner -->
    <div class="glass-card p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-25 rounded-pill px-3 py-1">
                    <i class="bi bi-shield-check me-1"></i> System Activity Audit Trail
                </span>
                <span class="text-secondary small">Total Audit Records: @Model.Count()</span>
            </div>
            <h2 class="fw-extrabold mb-0 text-white">Security & Operations Audit Monitor</h2>
        </div>
    </div>

    <!-- Search & Module Filter Bar -->
    <div class="glass-card p-3">
        <form method="get" asp-action="Index" class="row g-3 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary border-opacity-25 text-secondary"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@searchTerm" class="form-control" placeholder="Search by user, action, or details..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="module" class="form-select">
                    <option value="">-- All Modules --</option>
                    <option value="Auth" selected="@(selectedModule == "Auth")">Authentication & Security</option>
                    <option value="Rentals" selected="@(selectedModule == "Rentals")">Rental Contracts</option>
                    <option value="Payments" selected="@(selectedModule == "Payments")">Payments & Settlement</option>
                    <option value="Fleet" selected="@(selectedModule == "Fleet")">Vehicle Fleet</option>
                    <option value="Customers" selected="@(selectedModule == "Customers")">Customer Profiles</option>
                    <option value="Maintenance" selected="@(selectedModule == "Maintenance")">Fleet Maintenance</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-glow w-100">
                    <i class="bi bi-funnel me-1"></i> Filter Logs
                </button>
                <a asp-action="Index" class="btn btn-glass" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>

    <!-- Audit Logs Table -->
    <div class="glass-card p-4">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-secondary">
                <i class="bi bi-shield-x fs-1 d-block mb-3 text-muted"></i>
                <h4 class="text-white fw-bold">No audit records found</h4>
                <p class="mb-0">Actions taken across the system will be logged here automatically.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-futuristic align-middle">
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>User / Staff</th>
                            <th>Module</th>
                            <th>Action Performed</th>
                            <th>Operation Details</th>
                            <th>IP Address</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td><span class="text-secondary small font-monospace">@log.Timestamp.ToString("MMM dd, yyyy HH:mm:ss")</span></td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-sm bg-primary bg-opacity-25 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 12px;">
                                            @log.EmployeeName.Substring(0, Math.Min(2, log.EmployeeName.Length)).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-bold text-white">@log.EmployeeName</div>
                                            <span class="text-secondary small">ID: #EMP-@(log.EmployeeId?.ToString("D3") ?? "SYS")</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (log.Module == "Auth")
                                    {
                                        <span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-25">Auth</span>
                                    }
                                    else if (log.Module == "Rentals")
                                    {
                                        <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25">Rentals</span>
                                    }
                                    else if (log.Module == "Payments")
                                    {
                                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25">Payments</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-25">@log.Module</span>
                                    }
                                </td>
                                <td><span class="fw-semibold text-white">@log.Action</span></td>
                                <td><span class="text-secondary small">@log.Details</span></td>
                                <td><span class="text-muted small font-monospace">@(string.IsNullOrEmpty(log.IpAddress) ? "127.0.0.1" : log.IpAddress)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
