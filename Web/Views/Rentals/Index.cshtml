@model IEnumerable<RentalListDto>

@{
    ViewData["Title"] = "Rental Contracts Ledger";
}

<div class="d-flex flex-column gap-4">
    <!-- Header Banner -->
    <div class="glass-card p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1">
                    <i class="bi bi-file-earmark-text-fill me-1"></i> Contract Registry
                </span>
                <span class="text-secondary small">Total Contracts: @Model.Count()</span>
            </div>
            <h2 class="fw-extrabold mb-0 text-white">Rental Contract Ledger</h2>
        </div>
        <a asp-action="Open" class="btn btn-glow">
            <i class="bi bi-plus-lg me-1"></i> Open New Contract
        </a>
    </div>

    <!-- Contracts Table Card -->
    <div class="glass-card p-4">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-secondary">
                <i class="bi bi-file-earmark-x fs-1 d-block mb-3 text-muted"></i>
                <h4 class="text-white fw-bold">No rental contracts logged</h4>
                <p class="mb-4">Open a contract for a vehicle to start tracking rentals.</p>
                <a asp-action="Open" class="btn btn-glow">
                    <i class="bi bi-plus-lg me-1"></i> New Contract
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-futuristic align-middle">
                    <thead>
                        <tr>
                            <th>Contract ID</th>
                            <th>Vehicle</th>
                            <th>Renting Customer</th>
                            <th>Period</th>
                            <th>Total Amount</th>
                            <th>Paid / Balance</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rental in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-rentalId="@rental.Id" class="fw-bold text-primary text-decoration-none">
                                        #CNT-@rental.Id.ToString("D5")
                                    </a>
                                </td>
                                <td>
                                    <div class="fw-bold text-white">@rental.CarModel</div>
                                    <span class="text-secondary small">@rental.CarPlateNumber</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-white">@rental.CustomerName</div>
                                    <span class="text-secondary small"><i class="bi bi-telephone me-1"></i>@rental.CustomerPhone</span>
                                </td>
                                <td>
                                    <div class="small text-white">@rental.StartDate.ToString("MMM dd") - @rental.EndDate.ToString("MMM dd, yyyy")</div>
                                    <span class="text-secondary small">@Math.Max(1, (rental.EndDate - rental.StartDate).Days + 1) days</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-white">@((rental.FinalAmount ?? rental.TotalAmount).ToString("C"))</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-success">@rental.PaidAmount.ToString("C")</div>
                                    @if (rental.RemainingAmount > 0)
                                    {
                                        <span class="text-danger small fw-semibold">Due: @rental.RemainingAmount.ToString("C")</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25">Fully Paid</span>
                                    }
                                </td>
                                <td>
                                    @if (rental.Status == RentalContractStatus.Open)
                                    {
                                        <span class="status-pill pill-available"><i class="bi bi-clock-fill"></i> Active</span>
                                    }
                                    else if (rental.Status == RentalContractStatus.Closed)
                                    {
                                        <span class="status-pill pill-closed"><i class="bi bi-check-all"></i> Closed</span>
                                    }
                                    else if (rental.Status == RentalContractStatus.Cancelled)
                                    {
                                        <span class="status-pill pill-cancelled"><i class="bi bi-x-circle-fill"></i> Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill pill-maintenance">@rental.Status</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Details" asp-route-rentalId="@rental.Id" class="btn btn-glass btn-sm" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (rental.Status == RentalContractStatus.Open)
                                        {
                                            <a asp-action="Pay" asp-route-rentalId="@rental.Id" class="btn btn-glass btn-sm text-success" title="Record Payment">
                                                <i class="bi bi-wallet2"></i>
                                            </a>
                                            <a asp-action="Extend" asp-route-rentalId="@rental.Id" class="btn btn-glass btn-sm text-warning" title="Extend Contract">
                                                <i class="bi bi-calendar-plus"></i>
                                            </a>
                                            <a asp-action="Close" asp-route-rentalId="@rental.Id" class="btn btn-glass btn-sm text-primary" title="Close / Return Vehicle">
                                                <i class="bi bi-check-circle"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>