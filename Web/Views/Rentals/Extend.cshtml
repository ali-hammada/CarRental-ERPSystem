@model Application.Services.DTOs.ExtendRentalDto

@{
    ViewData["Title"] = "Extend Rental Contract";
    var rental = ViewBag.Rental as Application.DTOs.RentalListDto;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="glass-card p-4">
            <div class="d-flex align-items-center justify-content-between border-bottom border-secondary border-opacity-25 pb-3 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="kpi-icon bg-warning bg-opacity-25 text-warning">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-white mb-0">Extend Contract Period</h4>
                        <p class="text-secondary small mb-0">Select new end date to extend vehicle rental duration.</p>
                    </div>
                </div>
                <a asp-action="Index" class="btn btn-glass btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Ledger
                </a>
            </div>

            @if (rental != null)
            {
                <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25 mb-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="text-secondary small">Contract ID</div>
                            <div class="fw-bold text-primary">#CNT-@rental.Id.ToString("D5")</div>
                            <div class="text-secondary small mt-2">Vehicle Model</div>
                            <div class="fw-bold text-white">@rental.CarModel (@rental.CarPlateNumber)</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-secondary small">Current End Date</div>
                            <div class="fw-bold text-warning">@rental.EndDate.ToString("MMM dd, yyyy")</div>
                            <div class="text-secondary small mt-2">Daily Rate</div>
                            <div class="fw-bold text-success">@rental.DailyPrice.ToString("C") / day</div>
                        </div>
                    </div>
                </div>

                <form asp-action="Extend" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RentalId" value="@rental.Id" />

                    <div class="mb-3">
                        <label asp-for="NewEndDate" class="form-label text-secondary small fw-bold">New Extended End Date</label>
                        <input asp-for="NewEndDate" type="date" class="form-control" id="newEndDate" min="@rental.EndDate.AddDays(1).ToString("yyyy-MM-dd")" required />
                        <span asp-validation-for="NewEndDate" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label text-secondary small fw-bold">Extension Reason / Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Customer request, flight delay, etc..."></textarea>
                    </div>

                    <!-- Extension Cost Breakdown -->
                    <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-warning border-opacity-25 mb-4" id="extensionCost" style="display: none;">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <div class="text-warning small fw-bold">Additional Extension Days</div>
                                <div class="fs-5 text-white fw-bold"><span id="extraDays">0</span> Extra Days</div>
                            </div>
                            <div class="text-end">
                                <div class="text-warning small fw-bold">Additional Fee</div>
                                <div class="fs-4 fw-extrabold text-warning" id="extraCost">$0.00</div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 pt-2">
                        <a asp-action="Details" asp-route-rentalId="@rental.Id" class="btn btn-glass">Cancel</a>
                        <button type="submit" class="btn btn-glow px-4">
                            <i class="bi bi-calendar-check me-1"></i> Confirm Contract Extension
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const dailyPrice = @(rental?.DailyPrice ?? 0);
        const currentEndDate = new Date('@(rental?.EndDate.ToString("yyyy-MM-dd"))');
        const newEndDateInput = document.getElementById('newEndDate');
        const extensionCostDiv = document.getElementById('extensionCost');
        const extraDaysEl = document.getElementById('extraDays');
        const extraCostEl = document.getElementById('extraCost');

        newEndDateInput.addEventListener('change', function() {
            const newDate = new Date(this.value);
            if (newDate > currentEndDate) {
                const diffTime = Math.abs(newDate - currentEndDate);
                const extraDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                const extraCost = extraDays * dailyPrice;

                extraDaysEl.textContent = extraDays;
                extraCostEl.textContent = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(extraCost);
                extensionCostDiv.style.display = 'block';
            } else {
                extensionCostDiv.style.display = 'none';
            }
        });
    </script>
}