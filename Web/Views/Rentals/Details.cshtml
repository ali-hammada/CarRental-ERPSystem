@model Application.DTOs.RentalListDto

@{
    ViewData["Title"] = "Contract #CNT-" + Model.Id.ToString("D5");
    var amountDue = Model.FinalAmount ?? Model.TotalAmount;
    var remaining = amountDue - Model.PaidAmount;
    var payments = ViewBag.Payments as IEnumerable<ApplicationCore.Entities.Payment> ?? new List<ApplicationCore.Entities.Payment>();
}

<div class="d-flex flex-column gap-4">
    <!-- Header Banner -->
    <div class="glass-card p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="kpi-icon">
                <i class="bi bi-file-earmark-text-fill"></i>
            </div>
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1">
                        Contract #CNT-@Model.Id.ToString("D5")
                    </span>
                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 rounded-pill px-3 py-1">
                        @Model.Status
                    </span>
                </div>
                <h2 class="fw-extrabold mb-0 text-white">Rental Contract Lifecycle</h2>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="PrintContract" asp-route-rentalId="@Model.Id" target="_blank" class="btn btn-glass text-warning">
                <i class="bi bi-printer me-1"></i> Print Official Agreement
            </a>
            <a asp-action="Index" class="btn btn-glass">
                <i class="bi bi-arrow-left me-1"></i> Back to Ledger
            </a>
            @if (Model.Status == ApplicationCore.Enums.RentalContractStatus.Open)
            {
                <a asp-action="Close" asp-route-rentalId="@Model.Id" class="btn btn-glow">
                    <i class="bi bi-check-circle me-1"></i> Return & Close
                </a>
            }
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Details Column -->
        <div class="col-lg-8 d-flex flex-column gap-4">
            <!-- Vehicle & Customer Profile Card -->
            <div class="glass-card p-4">
                <h5 class="fw-bold text-white mb-4 d-flex align-items-center gap-2">
                    <i class="bi bi-car-front text-gradient"></i> Vehicle & Customer Summary
                </h5>
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25">
                            <div class="text-secondary small fw-bold mb-1">RENTED VEHICLE</div>
                            <div class="fs-5 fw-bold text-white">@Model.CarModel</div>
                            <div class="text-secondary small mt-1">Plate: <span class="text-gradient fw-bold">@Model.CarPlateNumber</span></div>
                            <div class="text-secondary small mt-1">Daily Rate: <span class="text-success fw-semibold">@Model.DailyPrice.ToString("C")</span></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25">
                            <div class="text-secondary small fw-bold mb-1">CUSTOMER PROFILE</div>
                            <div class="fs-5 fw-bold text-white">@Model.CustomerName</div>
                            <div class="text-secondary small mt-1">Phone: <span class="text-white">@Model.CustomerPhone</span></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Rental Timeline Card -->
            <div class="glass-card p-4">
                <h5 class="fw-bold text-white mb-4 d-flex align-items-center gap-2">
                    <i class="bi bi-calendar-range text-gradient"></i> Contract Timeline
                </h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="text-secondary small">Start Date</div>
                        <div class="fw-bold text-white mt-1">@Model.StartDate.ToString("MMMM dd, yyyy")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-secondary small">Expected End Date</div>
                        <div class="fw-bold text-warning mt-1">@Model.EndDate.ToString("MMMM dd, yyyy")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-secondary small">Rental Duration</div>
                        <div class="fw-bold text-gradient-emerald mt-1">
                            @Math.Max(1, (int)(Model.EndDate - Model.StartDate).TotalDays + 1) Days
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment History List -->
            <div class="glass-card p-4">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h5 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-receipt-cutoff text-gradient"></i> Payment History
                    </h5>
                    @if (remaining > 0 && Model.Status == ApplicationCore.Enums.RentalContractStatus.Open)
                    {
                        <a asp-controller="Payment" asp-action="MakePayment" asp-route-rentalId="@Model.Id" class="btn btn-glow btn-sm">
                            <i class="bi bi-plus-lg me-1"></i> Record Payment
                        </a>
                    }
                </div>
                @if (!payments.Any())
                {
                    <div class="text-center py-4 text-secondary">
                        <i class="bi bi-wallet2 fs-2 mb-2 d-block opacity-50"></i>
                        No payments recorded yet.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-futuristic align-middle">
                            <thead>
                                <tr>
                                    <th>Payment Date</th>
                                    <th>Purpose</th>
                                    <th>Method</th>
                                    <th>Reference</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in payments)
                                {
                                    <tr>
                                        <td><span class="text-secondary small">@p.PaymentDate.ToString("MMM dd, yyyy HH:mm")</span></td>
                                        <td><span class="fw-semibold text-white">@p.Purpose</span></td>
                                        <td><span class="badge bg-dark border border-secondary text-secondary">@p.Method</span></td>
                                        <td><span class="text-secondary small">@(string.IsNullOrEmpty(p.TransactionReference) ? "-" : p.TransactionReference)</span></td>
                                        <td class="text-end fw-bold text-success">@p.Amount.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Sidebar Summary Column -->
        <div class="col-lg-4 d-flex flex-column gap-4">
            <!-- Financial Settlement Card -->
            <div class="glass-card p-4">
                <h5 class="fw-bold text-white mb-4 d-flex align-items-center gap-2">
                    <i class="bi bi-calculator text-gradient"></i> Financial Ledger
                </h5>
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-secondary small">Base Contract Total</span>
                        <span class="fw-semibold text-white">@Model.TotalAmount.ToString("C")</span>
                    </div>
                    @if (Model.ExtraFees.HasValue && Model.ExtraFees > 0)
                    {
                        <div class="d-flex justify-content-between align-items-center text-warning">
                            <span class="small">Extra Fees / Mileage</span>
                            <span class="fw-semibold">@Model.ExtraFees.Value.ToString("C")</span>
                        </div>
                    }
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-25">
                        <span class="text-secondary small">Total Settlement</span>
                        <span class="fs-5 fw-bold text-white">@amountDue.ToString("C")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-secondary small">Amount Paid</span>
                        <span class="fw-bold text-success">@Model.PaidAmount.ToString("C")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-25">
                        <span class="fw-bold text-white">Remaining Balance</span>
                        <span class="fs-4 fw-extrabold @(remaining > 0 ? "text-danger" : "text-success")">@remaining.ToString("C")</span>
                    </div>
                </div>
            </div>

            <!-- Management Action Shortcuts -->
            <div class="glass-card p-4">
                <h5 class="fw-bold text-white mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-lightning-charge text-gradient"></i> Shortcuts
                </h5>
                <div class="d-grid gap-2">
                    @if (Model.Status == ApplicationCore.Enums.RentalContractStatus.Open)
                    {
                        @if (remaining > 0)
                        {
                            <a asp-controller="Payment" asp-action="MakePayment" asp-route-rentalId="@Model.Id" class="btn btn-glow w-100">
                                <i class="bi bi-credit-card me-1"></i> Make Payment
                            </a>
                        }
                        <a asp-action="Extend" asp-route-rentalId="@Model.Id" class="btn btn-glass text-warning w-100">
                            <i class="bi bi-clock-history me-1"></i> Extend Contract
                        </a>
                        <a asp-action="Close" asp-route-rentalId="@Model.Id" class="btn btn-glass text-primary w-100">
                            <i class="bi bi-check-circle me-1"></i> Return Vehicle & Close
                        </a>
                    }
                    else
                    {
                        <div class="p-3 rounded-3 bg-success bg-opacity-10 border border-success border-opacity-25 text-success text-center fw-semibold">
                            <i class="bi bi-check-all me-1"></i> Contract Completed
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
