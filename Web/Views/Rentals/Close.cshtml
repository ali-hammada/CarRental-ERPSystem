@model Application.Services.DTOs.RentalCloseDto

@{
    ViewData["Title"] = "Close Contract & Return Vehicle";
    var rental = ViewBag.Rental as Application.DTOs.RentalListDto;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="glass-card p-4">
            <div class="d-flex align-items-center justify-content-between border-bottom border-secondary border-opacity-25 pb-3 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="kpi-icon bg-primary bg-opacity-25 text-primary">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-white mb-0">Vehicle Inspection & Contract Closure</h4>
                        <p class="text-secondary small mb-0">Record return mileage, fuel level, and finalize contract settlement.</p>
                    </div>
                </div>
                <a asp-action="Index" class="btn btn-glass btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Ledger
                </a>
            </div>

            @if (rental != null)
            {
                <!-- Contract Info Summary -->
                <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25 mb-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="text-secondary small">Contract Number</div>
                            <div class="fw-bold text-primary">#CNT-@rental.Id.ToString("D5")</div>
                            <div class="text-secondary small mt-2">Vehicle / Plate</div>
                            <div class="fw-bold text-white">@rental.CarModel (@rental.CarPlateNumber)</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-secondary small">Customer Name</div>
                            <div class="fw-bold text-white">@rental.CustomerName</div>
                            <div class="text-secondary small mt-2">Paid Amount / Total</div>
                            <div class="fw-bold text-success">@rental.PaidAmount.ToString("C") <span class="text-secondary font-normal">/ @rental.TotalAmount.ToString("C")</span></div>
                        </div>
                    </div>
                </div>

                <form asp-action="Close" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RentalId" value="@rental.Id" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="EndOdometer" class="form-label text-secondary small fw-bold">Return Odometer Reading (KM)</label>
                            <input asp-for="EndOdometer" type="number" class="form-control" placeholder="Current Odometer" required />
                            <span asp-validation-for="EndOdometer" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EndFuelLevel" class="form-label text-secondary small fw-bold">Return Fuel Level</label>
                            <select asp-for="EndFuelLevel" class="form-select">
                                <option value="Full">Full Tank (100%)</option>
                                <option value="ThreeQuarters">3/4 Tank (75%)</option>
                                <option value="Half">Half Tank (50%)</option>
                                <option value="Quarter">1/4 Tank (25%)</option>
                                <option value="Empty">Empty Tank (0%)</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ExtraFees" class="form-label text-secondary small fw-bold">Additional Damage / Cleaning Fees ($)</label>
                            <input asp-for="ExtraFees" type="number" step="0.01" class="form-control" placeholder="0.00" />
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label text-secondary small fw-bold">Inspection & Return Notes</label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Condition of vehicle upon return, scratches, clean status..."></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top border-secondary border-opacity-25">
                        <a asp-action="Details" asp-route-rentalId="@rental.Id" class="btn btn-glass">Cancel</a>
                        <button type="submit" class="btn btn-glow px-4">
                            <i class="bi bi-check-all me-1"></i> Close Contract & Complete Return
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}