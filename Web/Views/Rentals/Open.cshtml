@model Application.Services.DTOs.RentalRequestDTO

@{
    ViewData["Title"] = "Open New Rental Contract";
    var availableCars = ViewBag.AvailableCars as IEnumerable<Application.DTOs.CarListDto> ?? new List<Application.DTOs.CarListDto>();
    var customers = ViewBag.Customers as IEnumerable<Application.DTOs.CustomerListDto> ?? new List<Application.DTOs.CustomerListDto>();
    var selectedCar = ViewBag.SelectedCar as Application.DTOs.CarListDto;
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="glass-card p-4">
            <!-- Form Header -->
            <div class="d-flex align-items-center justify-content-between border-bottom border-secondary border-opacity-25 pb-3 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="kpi-icon">
                        <i class="bi bi-file-earmark-plus-fill"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-white mb-0">Create Rental Contract</h4>
                        <p class="text-secondary small mb-0">Select vehicle, customer profile, and rental duration to generate contract.</p>
                    </div>
                </div>
                <a asp-action="Index" class="btn btn-glass btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Ledger
                </a>
            </div>

            <form asp-action="Open" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 p-3 bg-danger bg-opacity-10 border border-danger border-opacity-25 rounded-3"></div>

                <div class="row g-3">
                    <!-- Car Selection -->
                    <div class="col-md-6">
                        <label asp-for="CarId" class="form-label text-secondary small fw-bold">Select Vehicle</label>
                        <select asp-for="CarId" class="form-select" id="carSelect" required>
                            <option value="">-- Choose Available Vehicle --</option>
                            @foreach (var car in availableCars)
                            {
                                <option value="@car.Id" data-price="@car.PricePerDay" data-odometer="@car.CurrentOdometer" selected="@(Model.CarId == car.Id)">
                                    @car.Model (@car.PlateNumber) - @car.PricePerDay.ToString("C")/day
                                </option>
                            }
                        </select>
                        <span asp-validation-for="CarId" class="text-danger small"></span>
                    </div>

                    <!-- Customer Selection -->
                    <div class="col-md-6">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="CustomerId" class="form-label text-secondary small fw-bold mb-0">Renting Customer</label>
                            <a asp-controller="Customers" asp-action="Create" class="text-gradient small text-decoration-none">+ New Customer</a>
                        </div>
                        <select asp-for="CustomerId" class="form-select" id="customerSelect" required>
                            <option value="">-- Select Customer Profile --</option>
                            @foreach (var cust in customers)
                            {
                                <option value="@cust.Id" data-license-expired="@cust.IsLicenseExpired" selected="@(Model.CustomerId == cust.Id)">
                                    @cust.Name (@cust.Phone) - Lic: @cust.DrivingLicenseNumber
                                </option>
                            }
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger small"></span>
                    </div>

                    <!-- Start & End Date -->
                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label text-secondary small fw-bold">Contract Start Date</label>
                        <input asp-for="StartDate" type="date" class="form-control" id="startDate" required min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EndDate" class="form-label text-secondary small fw-bold">Expected End Date</label>
                        <input asp-for="EndDate" type="date" class="form-control" id="endDate" required min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>

                    <!-- Deposit & Odometer -->
                    <div class="col-md-4">
                        <label asp-for="DepositAmount" class="form-label text-secondary small fw-bold">Security Deposit ($)</label>
                        <input asp-for="DepositAmount" type="number" step="0.01" class="form-control" placeholder="100.00" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="StartOdometer" class="form-label text-secondary small fw-bold">Departure Odometer (KM)</label>
                        <input asp-for="StartOdometer" type="number" class="form-control" id="startOdometer" placeholder="0" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="StartFuelLevel" class="form-label text-secondary small fw-bold">Fuel Level at Departure</label>
                        <select asp-for="StartFuelLevel" class="form-select">
                            <option value="Full">Full Tank (100%)</option>
                            <option value="ThreeQuarters">3/4 Tank (75%)</option>
                            <option value="Half">Half Tank (50%)</option>
                            <option value="Quarter">1/4 Tank (25%)</option>
                        </select>
                    </div>

                    <!-- Notes -->
                    <div class="col-12">
                        <label asp-for="Notes" class="form-label text-secondary small fw-bold">Contract Notes / Terms</label>
                        <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Inspection notes, additional driver details..."></textarea>
                    </div>
                </div>

                <!-- Real-time Financial Breakdown Widget -->
                <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25 my-4" id="costWidget">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-secondary small fw-bold uppercase">Estimated Duration & Total</div>
                            <div class="fs-5 text-white fw-bold mt-1">
                                <span id="daysCount">1</span> Rental Days @@ <span id="dailyPriceRate">$0.00</span>/day
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="text-secondary small fw-bold">Estimated Total (Inc 14% VAT)</div>
                            <div class="fs-3 fw-extrabold text-gradient-emerald" id="estimatedTotal">$0.00</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 pt-2">
                    <a asp-action="Index" class="btn btn-glass">Cancel</a>
                    <button type="submit" class="btn btn-glow px-4">
                        <i class="bi bi-file-earmark-check me-1"></i> Issue Contract & Generate Tax Invoice
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const carSelect = document.getElementById('carSelect');
        const startDateInput = document.getElementById('startDate');
        const endDateInput = document.getElementById('endDate');
        const startOdometer = document.getElementById('startOdometer');
        const daysCount = document.getElementById('daysCount');
        const dailyPriceRate = document.getElementById('dailyPriceRate');
        const estimatedTotal = document.getElementById('estimatedTotal');

        function updateCalculation() {
            const selectedOpt = carSelect.options[carSelect.selectedIndex];
            const price = parseFloat(selectedOpt?.getAttribute('data-price')) || 0;
            const odo = selectedOpt?.getAttribute('data-odometer');

            if (odo && (!startOdometer.value || startOdometer.value == 0)) {
                startOdometer.value = odo;
            }

            const start = new Date(startDateInput.value);
            const end = new Date(endDateInput.value);

            let days = 1;
            if (start && end && end >= start) {
                days = Math.max(1, Math.ceil((end - start) / (1000 * 60 * 60 * 24)) + 1);
            }

            const total = days * price;

            daysCount.textContent = days;
            dailyPriceRate.textContent = formatCurrency(price);
            estimatedTotal.textContent = formatCurrency(total);
        }

        function formatCurrency(val) {
            return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(val);
        }

        carSelect.addEventListener('change', updateCalculation);
        startDateInput.addEventListener('change', updateCalculation);
        endDateInput.addEventListener('change', updateCalculation);

        updateCalculation();
    </script>
}