@model Web.ViewModels.ActiveRentalsViewModel

@{
    ViewData["Title"] = "Active Rentals";
}

<div class="d-flex flex-column gap-4">
    <div class="glass-card p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-25 rounded-pill px-3 py-1">
                    <i class="bi bi-clock-history me-1"></i> Active Operations
                </span>
                <span class="text-secondary small">Total Active: @Model.Rentals.Count()</span>
            </div>
            <h2 class="fw-extrabold mb-0 text-white">Active Rental Vehicles</h2>
        </div>
        <form asp-action="Active" method="get" class="d-flex gap-2">
            <input type="text" name="searchTerm" class="form-control form-control-sm" placeholder="Search car plate or customer..." value="@Model.SearchTerm" />
            <button type="submit" class="btn btn-glass btn-sm"><i class="bi bi-search"></i></button>
        </form>
    </div>

    <div class="glass-card p-4">
        @if (!Model.Rentals.Any())
        {
            <div class="text-center py-5 text-secondary">
                <i class="bi bi-inbox fs-1 d-block mb-3 text-muted"></i>
                <h4 class="text-white fw-bold">No active rentals found</h4>
                <p class="mb-4">There are currently no active open rental contracts.</p>
                <a asp-controller="Car" asp-action="Index" class="btn btn-glow">
                    <i class="bi bi-car-front me-1"></i> Browse Fleet
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-futuristic align-middle">
                    <thead>
                        <tr>
                            <th>Contract ID</th>
                            <th>Car Model</th>
                            <th>Plate Number</th>
                            <th>Customer</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Total Amount</th>
                            <th>Paid / Balance</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rental in Model.Rentals)
                        {
                            <tr>
                                <td><a asp-action="Details" asp-route-rentalId="@rental.Id" class="fw-bold text-primary text-decoration-none">#CNT-@rental.Id.ToString("D5")</a></td>
                                <td><span class="fw-bold text-white">@rental.CarModel</span></td>
                                <td><span class="badge bg-dark border border-secondary border-opacity-25 text-primary">@rental.CarPlateNumber</span></td>
                                <td><span class="fw-semibold text-white">@rental.CustomerName</span></td>
                                <td><span class="text-secondary small">@rental.StartDate.ToString("MMM dd, yyyy")</span></td>
                                <td><span class="text-secondary small">@rental.EndDate.ToString("MMM dd, yyyy")</span></td>
                                <td><span class="fw-bold text-white">@((rental.FinalAmount ?? rental.TotalAmount).ToString("C"))</span></td>
                                <td>
                                    <div class="fw-bold text-success">@rental.PaidAmount.ToString("C")</div>
                                    @if (rental.RemainingAmount > 0)
                                    {
                                        <span class="text-danger small fw-semibold">Due: @rental.RemainingAmount.ToString("C")</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25">Fully Paid</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Details" asp-route-rentalId="@rental.Id" class="btn btn-glass btn-sm"><i class="bi bi-eye"></i></a>
                                        <a asp-action="Pay" asp-route-rentalId="@rental.Id" class="btn btn-glass btn-sm text-success"><i class="bi bi-wallet2"></i></a>
                                        <a asp-action="Extend" asp-route-rentalId="@rental.Id" class="btn btn-glass btn-sm text-warning"><i class="bi bi-calendar-plus"></i></a>
                                        <a asp-action="Close" asp-route-rentalId="@rental.Id" class="btn btn-glass btn-sm text-primary"><i class="bi bi-check-circle"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
