@model ApplicationCore.Entities.Car

@{
    var isEdit = Model != null && Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit Vehicle" : "Add New Vehicle";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="glass-card p-4">
            <div class="d-flex align-items-center justify-content-between border-bottom border-secondary border-opacity-25 pb-3 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="kpi-icon">
                        <i class="bi bi-car-front-fill"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-white mb-0">@(isEdit ? "Edit Vehicle Specs" : "Add New Vehicle to Fleet")</h4>
                        <p class="text-secondary small mb-0">Enter full specifications, plate number, and daily rental rate.</p>
                    </div>
                </div>
                <a asp-action="Index" class="btn btn-glass btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Fleet
                </a>
            </div>

            <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
                @if (isEdit)
                {
                    <input type="hidden" asp-for="Id" />
                }

                <div class="row g-3">
                    <!-- Fleet Listing Purpose (Selected First) -->
                    <div class="col-12">
                        <div class="p-3 rounded-3 bg-dark bg-opacity-60 border border-primary border-opacity-25 mb-2">
                            <label asp-for="ListingType" class="form-label text-white small fw-bold mb-2">
                                <i class="bi bi-gear-wide-connected text-primary me-1"></i> What is the purpose of adding this vehicle? (غرض السيارة) *
                            </label>
                            <select asp-for="ListingType" class="form-select fs-6 fw-bold text-primary" id="listingTypeSelect" asp-items="Html.GetEnumSelectList<ApplicationCore.Enums.CarListingType>()"></select>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Model" class="form-label text-secondary small fw-bold">Vehicle Model / Make</label>
                        <input asp-for="Model" class="form-control" placeholder="e.g. BMW X5 M-Sport" required />
                        <span asp-validation-for="Model" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PlateNumber" class="form-label text-secondary small fw-bold">License Plate Number</label>
                        <input asp-for="PlateNumber" class="form-control" placeholder="e.g. ABC-1234" required />
                        <span asp-validation-for="PlateNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Year" class="form-label text-secondary small fw-bold">Manufacturing Year</label>
                        <input asp-for="Year" type="number" class="form-control" placeholder="2024" required />
                        <span asp-validation-for="Year" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4" id="rentalPriceGroup">
                        <label asp-for="PricePerDay" class="form-label text-secondary small fw-bold">Daily Rental Rate ($) [سعر الإيجار اليومي]</label>
                        <input asp-for="PricePerDay" type="number" step="0.01" class="form-control text-success fw-bold" id="pricePerDayInput" placeholder="95.00" />
                        <span asp-validation-for="PricePerDay" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="CurrentOdometer" class="form-label text-secondary small fw-bold">Current Odometer (KM)</label>
                        <input asp-for="CurrentOdometer" type="number" class="form-control" placeholder="15000" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="FuelType" class="form-label text-secondary small fw-bold">Fuel Type</label>
                        <select asp-for="FuelType" class="form-select">
                            <option value="Gasoline">Gasoline</option>
                            <option value="Diesel">Diesel</option>
                            <option value="Hybrid">Hybrid</option>
                            <option value="Electric">Electric</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Transmission" class="form-label text-secondary small fw-bold">Transmission</label>
                        <select asp-for="Transmission" class="form-select">
                            <option value="Automatic">Automatic</option>
                            <option value="Manual">Manual</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Status" class="form-label text-secondary small fw-bold">Initial Vehicle Status</label>
                        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ApplicationCore.Enums.CarStatus>()"></select>
                    </div>

                    <div class="col-12">
                        <label asp-for="ImageUrl" class="form-label text-secondary small fw-bold">Vehicle Image URL (Optional)</label>
                        <input asp-for="ImageUrl" type="url" class="form-control" placeholder="https://images.unsplash.com/photo-..." />
                    </div>

                    <!-- Dealership Procurement & Floor Price Negotiation Settings -->
                    <div class="col-12 mt-4 pt-3 border-top border-secondary border-opacity-25" id="salesProcurementGroup">
                        <div class="p-3.5 rounded-3 bg-dark bg-opacity-60 border border-success border-opacity-25">
                            <h6 class="fw-bold text-success mb-2 d-flex align-items-center gap-2">
                                <i class="bi bi-tag-fill"></i> Dealership Procurement & Negotiation Floor Settings (معرض البيع والشراء)
                            </h6>
                            <p class="text-secondary small mb-3">Track actual vehicle purchase costs, preparation expenses, and set negotiation floor limits for sales agents.</p>
                            
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="PurchasePrice" class="form-label text-secondary small fw-bold">Original Purchase Price ($) [سعر الشراء الاصلي]</label>
                                    <input asp-for="PurchasePrice" type="number" step="0.01" class="form-control" placeholder="e.g. 18000.00" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="RefurbishmentCost" class="form-label text-secondary small fw-bold">Prep & Repair Expenses ($) [مصاريف التجهيز والرش]</label>
                                    <input asp-for="RefurbishmentCost" type="number" step="0.01" class="form-control" placeholder="e.g. 2000.00" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="TargetSalePrice" class="form-label text-secondary small fw-bold">Target Asking Sale Price ($) [السعر المعلن للبيع]</label>
                                    <input asp-for="TargetSalePrice" type="number" step="0.01" class="form-control text-success fw-bold" placeholder="e.g. 24000.00" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="MinimumFloorPrice" class="form-label text-secondary small fw-bold">Minimum Negotiable Floor Price ($) [أدنى سعر للتفاوض]</label>
                                    <input asp-for="MinimumFloorPrice" type="number" step="0.01" class="form-control text-warning fw-bold" placeholder="e.g. 22000.00" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <a asp-action="Index" class="btn btn-glass">Cancel</a>
                    <button type="submit" class="btn btn-glow px-4">
                        <i class="bi bi-check-lg me-1"></i> Save Vehicle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            function updatePurposeVisibility() {
                var purpose = $('#listingTypeSelect').val(); // 1 = RentalOnly, 2 = SaleOnly, 3 = Both
                if (purpose === '1') {
                    $('#rentalPriceGroup').slideDown();
                    $('#salesProcurementGroup').slideUp();
                    $('#pricePerDayInput').attr('required', 'required');
                } else if (purpose === '2') {
                    $('#rentalPriceGroup').slideUp();
                    $('#salesProcurementGroup').slideDown();
                    $('#pricePerDayInput').removeAttr('required');
                } else {
                    $('#rentalPriceGroup').slideDown();
                    $('#salesProcurementGroup').slideDown();
                    $('#pricePerDayInput').attr('required', 'required');
                }
            }

            $('#listingTypeSelect').on('change', updatePurposeVisibility);
            updatePurposeVisibility();
        });
    </script>
}