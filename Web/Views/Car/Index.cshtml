@model IEnumerable<CarListDto>

@{
    ViewData["Title"] = "Fleet Management";
}

<div class="d-flex flex-column gap-4">
    <!-- Header Banner -->
    <div class="glass-card p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1">
                    <i class="bi bi-car-front-fill me-1"></i> Fleet Management
                </span>
                <span class="text-secondary small">Total Vehicles: @Model.Count()</span>
            </div>
            <h2 class="fw-extrabold mb-0 text-white">Vehicle Fleet Catalog</h2>
        </div>
        <a asp-action="Create" class="btn btn-glow">
            <i class="bi bi-plus-lg me-1"></i> Add New Vehicle
        </a>
    </div>

    <!-- Sub-Navigation Inventory Tabs -->
    @{
        var activeTab = ViewBag.ActiveTab as string ?? "all";
    }
    <div class="d-flex align-items-center justify-content-between">
        <div class="nav nav-pills gap-2 bg-dark bg-opacity-50 p-1.5 rounded-pill border border-secondary border-opacity-25">
            <a asp-action="Index" asp-route-type="rental" class="nav-link rounded-pill px-3 py-1.5 small @(activeTab == "rental" ? "active bg-primary text-white fw-bold" : "text-white")">
                <i class="bi bi-car-front-fill me-1"></i> Rental Fleet (أسطول الإيجارات)
            </a>
            <a asp-action="SalesCatalog" class="nav-link rounded-pill px-3 py-1.5 small text-white">
                <i class="bi bi-tag-fill me-1 text-success"></i> Sales Showroom (معرض البيع والشراء)
            </a>
            <a asp-action="Index" asp-route-type="all" class="nav-link rounded-pill px-3 py-1.5 small @(activeTab == "all" ? "active bg-primary text-white fw-bold" : "text-white")">
                All Fleet Vehicles
            </a>
        </div>
    </div>

    <!-- Vehicles Cards Grid -->
    @if (!Model.Any())
    {
        <div class="glass-card p-5 text-center text-secondary">
            <i class="bi bi-car-front fs-1 d-block mb-3 text-muted"></i>
            <h4 class="text-white fw-bold">No vehicles in fleet catalog</h4>
            <p class="mb-4">Add your first vehicle to start taking rental contracts.</p>
            <a asp-action="Create" class="btn btn-glow">
                <i class="bi bi-plus-lg me-1"></i> Add Vehicle
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var car in Model)
            {
                <div class="col-xl-4 col-md-6">
                    <div class="glass-card h-100 d-flex flex-column overflow-hidden">
                        <!-- Vehicle Header Image / Fallback -->
                        <div class="position-relative bg-dark" style="height: 220px; overflow: hidden; border-top-left-radius: var(--radius-lg); border-top-right-radius: var(--radius-lg);">
                            @if (!string.IsNullOrEmpty(car.ImageUrl))
                            {
                                <img src="@car.ImageUrl" alt="@car.Model" class="w-100 h-100" style="object-fit: cover; object-position: center;">
                                <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(180deg, rgba(15, 23, 42, 0.7) 0%, rgba(15, 23, 42, 0.1) 40%, rgba(15, 23, 42, 0.9) 100%); pointer-events: none;"></div>
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-dark bg-opacity-75">
                                    <i class="bi bi-car-front-fill fs-1 text-secondary opacity-50"></i>
                                </div>
                            }
                            
                            <!-- Status Overlay Badge -->
                            <div class="position-absolute top-0 end-0 m-3 z-2">
                                @if (car.Status == CarStatus.Available)
                                {
                                    <span class="status-pill pill-available shadow-sm"><i class="bi bi-check-circle-fill"></i> Available</span>
                                }
                                else if (car.Status == CarStatus.Rented)
                                {
                                    <span class="status-pill pill-rented shadow-sm"><i class="bi bi-clock-fill"></i> Rented</span>
                                }
                                else
                                {
                                    <span class="status-pill pill-maintenance shadow-sm"><i class="bi bi-tools"></i> Maintenance</span>
                                }
                            </div>
                        </div>

                        <!-- Card Body Content -->
                        <div class="p-4 d-flex flex-column flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h4 class="fw-bold text-white mb-0">@car.Model</h4>
                                    <span class="text-secondary small">Plate: <span class="text-primary fw-bold">@car.PlateNumber</span></span>
                                </div>
                                <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25 fs-7 px-3 py-1">@car.Year</span>
                            </div>

                            <div class="my-3 p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-10 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-secondary small">Daily Rate</div>
                                    <div class="fs-4 fw-extrabold text-gradient-emerald">@car.PricePerDay.ToString("C") <span class="fs-7 text-secondary fw-normal">/ day</span></div>
                                </div>
                                <div class="text-end">
                                    <div class="text-secondary small">Odometer</div>
                                    <div class="fw-bold text-white">@car.CurrentOdometer.ToString("N0") KM</div>
                                </div>
                            </div>

                            <div class="d-flex gap-2 text-secondary small mb-4">
                                <span class="badge bg-dark border border-secondary border-opacity-25 px-2 py-1"><i class="bi bi-fuel-pump me-1"></i> @car.FuelType</span>
                                <span class="badge bg-dark border border-secondary border-opacity-25 px-2 py-1"><i class="bi bi-gear-wide-connected me-1"></i> @car.Transmission</span>
                            </div>

                            <!-- Actions Footer -->
                            <div class="mt-auto d-flex gap-2">
                                @if (car.Status == CarStatus.Available)
                                {
                                    <a asp-controller="Rentals" asp-action="Open" asp-route-carId="@car.Id" class="btn btn-glow btn-sm flex-grow-1">
                                        <i class="bi bi-key-fill me-1"></i> Rent Vehicle
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-glass btn-sm flex-grow-1 text-secondary" disabled>
                                        <i class="bi bi-lock-fill me-1"></i> Occupied
                                    </button>
                                }

                                <button type="button" class="btn btn-glass btn-sm text-info px-2.5" data-bs-toggle="modal" data-bs-target="#contractModal_@car.Id" title="المرفقات والعقود القانونية والمالية">
                                    <i class="bi bi-folder-symlink-fill"></i>
                                </button>

                                <a asp-action="Edit" asp-route-id="@car.Id" class="btn btn-glass btn-sm" title="Edit Vehicle">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <form asp-action="Delete" asp-route-id="@car.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this vehicle?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-glass btn-sm text-danger" title="Delete Vehicle">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Legal & Financial Contracts Modal -->
                    <div class="modal fade" id="contractModal_@car.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-lg">
                            <div class="modal-content glass-card border-secondary">
                                <div class="modal-header border-bottom border-secondary border-opacity-25">
                                    <h5 class="modal-header-title fw-bold text-white mb-0 d-flex align-items-center gap-2">
                                        <i class="bi bi-file-earmark-pdf-fill text-warning fs-4"></i>
                                        المرفقات والعقود القانونية والمالية - @car.Model (@car.PlateNumber)
                                    </h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <form asp-controller="Car" asp-action="UploadContractDocument" method="post" enctype="multipart/form-data">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="carId" value="@car.Id" />

                                    <div class="modal-body d-flex flex-column gap-4 py-4">
                                        <!-- Original Purchase Contract Section -->
                                        <div class="p-3.5 rounded-3 bg-dark bg-opacity-60 border border-primary border-opacity-25">
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <h6 class="fw-bold text-primary mb-0 d-flex align-items-center gap-2">
                                                    <i class="bi bi-journal-check fs-5"></i> 1. عقد الشراء والتمليك الأصلي (العقد بين المعرض والبائع الأصلي)
                                                </h6>
                                                @if (!string.IsNullOrEmpty(car.OriginalPurchaseContractUrl))
                                                {
                                                    <a href="@car.OriginalPurchaseContractUrl" target="_blank" class="btn btn-sm btn-glass text-success fw-bold">
                                                        <i class="bi bi-eye-fill me-1"></i> معاينة / فتح العقد الأصلي
                                                    </a>
                                                }
                                            </div>
                                            <p class="text-secondary small mb-3">صورة عقد الشراء الذي تم بموجبه ملكية السيارة للمعرض شاملاً التفاصيل المالية والقانونية.</p>
                                            <input type="file" name="OriginalPurchaseContract" class="form-control" accept="image/*,.pdf" />
                                        </div>

                                        <!-- Final Customer Sales Contract Section -->
                                        <div class="p-3.5 rounded-3 bg-dark bg-opacity-60 border border-success border-opacity-25">
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <h6 class="fw-bold text-success mb-0 d-flex align-items-center gap-2">
                                                    <i class="bi bi-file-earmark-text-fill fs-5"></i> 2. عقد البيع والتسليم النهائي للعميل المشتري
                                                </h6>
                                                @if (!string.IsNullOrEmpty(car.FinalBuyerContractUrl))
                                                {
                                                    <a href="@car.FinalBuyerContractUrl" target="_blank" class="btn btn-sm btn-glass text-success fw-bold">
                                                        <i class="bi bi-eye-fill me-1"></i> معاينة / فتح عقد البيع للعميل
                                                    </a>
                                                }
                                            </div>
                                            <p class="text-secondary small mb-3">صورة العقد المكتوب والموقع بين المعرض والعميل المشتري عند البيع النهائي.</p>
                                            <input type="file" name="FinalBuyerContract" class="form-control" accept="image/*,.pdf" />
                                        </div>
                                    </div>

                                    <div class="modal-footer border-top border-secondary border-opacity-25">
                                        <button type="button" class="btn btn-glass" data-bs-dismiss="modal">إلغاء</button>
                                        <button type="submit" class="btn btn-glow px-4">
                                            <i class="bi bi-cloud-upload-fill me-1"></i> حفظ ورفع العقود القانونية
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>