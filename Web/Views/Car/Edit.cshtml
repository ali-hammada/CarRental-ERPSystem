@model ApplicationCore.Entities.Car

@{
    ViewData["Title"] = "Edit Vehicle";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="glass-card p-4">
            <div class="d-flex align-items-center justify-content-between border-bottom border-secondary border-opacity-25 pb-3 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="kpi-icon">
                        <i class="bi bi-pencil-square"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-white mb-0">Edit Vehicle Specification</h4>
                        <p class="text-secondary small mb-0">Update rate, status, odometer reading, or vehicle photo.</p>
                    </div>
                </div>
                <a asp-action="Index" class="btn btn-glass btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Fleet
                </a>
            </div>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Model" class="form-label text-secondary small fw-bold">Vehicle Model / Make</label>
                        <input asp-for="Model" class="form-control" required />
                        <span asp-validation-for="Model" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PlateNumber" class="form-label text-secondary small fw-bold">License Plate Number</label>
                        <input asp-for="PlateNumber" class="form-control" required />
                        <span asp-validation-for="PlateNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Year" class="form-label text-secondary small fw-bold">Manufacturing Year</label>
                        <input asp-for="Year" type="number" class="form-control" required />
                        <span asp-validation-for="Year" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="PricePerDay" class="form-label text-secondary small fw-bold">Daily Rental Price ($)</label>
                        <input asp-for="PricePerDay" type="number" step="0.01" class="form-control" required />
                        <span asp-validation-for="PricePerDay" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="CurrentOdometer" class="form-label text-secondary small fw-bold">Current Odometer (KM)</label>
                        <input asp-for="CurrentOdometer" type="number" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="FuelType" class="form-label text-secondary small fw-bold">Fuel Type</label>
                        <select asp-for="FuelType" class="form-select">
                            <option value="Gasoline">Gasoline</option>
                            <option value="Diesel">Diesel</option>
                            <option value="Hybrid">Hybrid</option>
                            <option value="Electric">Electric</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Transmission" class="form-label text-secondary small fw-bold">Transmission</label>
                        <select asp-for="Transmission" class="form-select">
                            <option value="Automatic">Automatic</option>
                            <option value="Manual">Manual</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Status" class="form-label text-secondary small fw-bold">Vehicle Status</label>
                        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<CarStatus>()"></select>
                    </div>

                    <div class="col-12">
                        <label asp-for="ImageUrl" class="form-label text-secondary small fw-bold">Vehicle Image URL (Optional)</label>
                        <input asp-for="ImageUrl" type="url" class="form-control" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <a asp-action="Index" class="btn btn-glass">Cancel</a>
                    <button type="submit" class="btn btn-glow px-4">
                        <i class="bi bi-check-lg me-1"></i> Update Vehicle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>