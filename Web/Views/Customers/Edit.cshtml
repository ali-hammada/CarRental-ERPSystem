@model ApplicationCore.Entities.Customer

@{
    ViewData["Title"] = "Edit Customer Profile";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="glass-card p-4">
            <div class="d-flex align-items-center justify-content-between border-bottom border-secondary border-opacity-25 pb-3 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="kpi-icon">
                        <i class="bi bi-person-fill-gear"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-white mb-0">Edit Customer Profile</h4>
                        <p class="text-secondary small mb-0">Update contact info, address, or driving license expiration date.</p>
                    </div>
                </div>
                <a asp-action="Index" class="btn btn-glass btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Catalog
                </a>
            </div>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 p-3 bg-danger bg-opacity-10 border border-danger border-opacity-25 rounded-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label text-secondary small fw-bold">Full Name</label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label text-secondary small fw-bold">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label text-secondary small fw-bold">Phone Number</label>
                        <input asp-for="Phone" type="tel" class="form-control" required />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NationalId" class="form-label text-secondary small fw-bold">National ID / Passport Number</label>
                        <input asp-for="NationalId" class="form-control" />
                        <span asp-validation-for="NationalId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DrivingLicenseNumber" class="form-label text-secondary small fw-bold">Driving License Number</label>
                        <input asp-for="DrivingLicenseNumber" class="form-control" required />
                        <span asp-validation-for="DrivingLicenseNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LicenseExpiryDate" class="form-label text-secondary small fw-bold">Driving License Expiry Date</label>
                        <input asp-for="LicenseExpiryDate" type="date" class="form-control" required />
                        <span asp-validation-for="LicenseExpiryDate" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Address" class="form-label text-secondary small fw-bold">Residential Address</label>
                        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <a asp-action="Index" class="btn btn-glass">Cancel</a>
                    <button type="submit" class="btn btn-glow px-4">
                        <i class="bi bi-check-lg me-1"></i> Update Profile
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}