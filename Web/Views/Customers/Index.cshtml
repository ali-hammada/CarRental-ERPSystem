@model IEnumerable<CustomerListDto>

@{
    ViewData["Title"] = "Customer Management";
}

<div class="d-flex flex-column gap-4">
    <!-- Header Banner -->
    <div class="glass-card p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1">
                    <i class="bi bi-people-fill me-1"></i> Customer Catalog
                </span>
                <span class="text-secondary small">Total Registered: @Model.Count()</span>
            </div>
            <h2 class="fw-extrabold mb-0 text-white">Registered Customer Profiles</h2>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-glow">
                <i class="bi bi-person-plus-fill me-1"></i> Register New Customer
            </a>
        </div>
    </div>

    <!-- Data Grid Table View -->
    <div class="glass-card p-4">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-secondary">
                <i class="bi bi-people fs-1 d-block mb-3 text-muted"></i>
                <h4 class="text-white fw-bold">No customers registered</h4>
                <p class="mb-4">Register customer profiles to open rental contracts.</p>
                <a asp-action="Create" class="btn btn-glow">
                    <i class="bi bi-person-plus-fill me-1"></i> Register Customer
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-futuristic align-middle">
                    <thead>
                        <tr>
                            <th>Customer ID</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>License Number</th>
                            <th>License Expiry</th>
                            <th>Active Rentals</th>
                            <th>License Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model)
                        {
                            <tr>
                                <td><span class="text-secondary small font-monospace">#CST-@customer.Id.ToString("D4")</span></td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary bg-opacity-25 text-primary d-flex align-items-center justify-content-center fw-bold small" style="width: 32px; height: 32px;">
                                            @customer.Name.Substring(0, 1).ToUpper()
                                        </div>
                                        <span class="fw-bold text-white">@customer.Name</span>
                                    </div>
                                </td>
                                <td><span class="text-secondary small">@customer.Email</span></td>
                                <td><span class="text-white fw-semibold">@customer.Phone</span></td>
                                <td><span class="text-gradient font-monospace fw-bold">@customer.DrivingLicenseNumber</span></td>
                                <td><span class="text-secondary small">@customer.LicenseExpiryDate.ToString("MMM dd, yyyy")</span></td>
                                <td>
                                    @if (customer.ActiveRentalsCount > 0)
                                    {
                                        <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25">
                                            <i class="bi bi-car-front me-1"></i> @customer.ActiveRentalsCount Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">None</span>
                                    }
                                </td>
                                <td>
                                    @if (customer.IsLicenseExpired)
                                    {
                                        <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-25">Expired</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25">Valid</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-glass btn-sm" title="Edit Profile">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@customer.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this customer profile?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-glass btn-sm text-danger" title="Delete Profile">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>