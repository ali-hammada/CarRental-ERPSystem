@model ApplicationCore.Entities.MaintenanceLog
@using ApplicationCore.Enums

@{
    ViewData["Title"] = "New Maintenance Log";
    var cars = ViewBag.Cars as IEnumerable<ApplicationCore.Entities.Car> ?? new List<ApplicationCore.Entities.Car>();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="glass-card p-4">
            <div class="d-flex align-items-center justify-content-between border-bottom border-secondary border-opacity-25 pb-3 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="kpi-icon bg-warning bg-opacity-25 text-warning">
                        <i class="bi bi-tools"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-white mb-0">Record Vehicle Maintenance</h4>
                        <p class="text-secondary small mb-0">Enter service type, cost, odometer reading, and workshop provider.</p>
                    </div>
                </div>
                <a asp-action="Index" class="btn btn-glass btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Logs
                </a>
            </div>

            <!-- Dynamic Rented Warning Alert -->
            <div id="rentedCarAlert" class="alert alert-warning border-warning border-opacity-25 rounded-3 mb-4 d-none">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill fs-5 text-warning"></i>
                    <div>
                        <strong class="text-white">Vehicle Currently Rented Out!</strong>
                        <div class="small text-secondary">This vehicle is on an active rental contract and cannot enter maintenance until returned and closed.</div>
                    </div>
                </div>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 p-3 bg-danger bg-opacity-10 border border-danger border-opacity-25 rounded-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CarId" class="form-label text-secondary small fw-bold">Select Vehicle</label>
                        <select asp-for="CarId" class="form-select" id="carSelect" required>
                            <option value="">-- Choose Vehicle --</option>
                            @foreach (var car in cars)
                            {
                                var isRented = car.Status == CarStatus.Rented;
                                <option value="@car.Id" data-status="@car.Status" selected="@(Model.CarId == car.Id)">
                                    @car.Model (@car.PlateNumber) @(isRented ? "- [RENTED OUT]" : $"[{car.Status}]")
                                </option>
                            }
                        </select>
                        <span asp-validation-for="CarId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ServiceType" class="form-label text-secondary small fw-bold">Service Type</label>
                        <input asp-for="ServiceType" class="form-control" placeholder="e.g. Oil Change & Brake Inspection" required />
                        <span asp-validation-for="ServiceType" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ServiceDate" class="form-label text-secondary small fw-bold">Service Date</label>
                        <input asp-for="ServiceDate" type="date" class="form-control" required />
                        <span asp-validation-for="ServiceDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Cost" class="form-label text-secondary small fw-bold">Service Cost ($)</label>
                        <input asp-for="Cost" type="number" step="0.01" class="form-control" placeholder="150.00" required />
                        <span asp-validation-for="Cost" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="OdometerReading" class="form-label text-secondary small fw-bold">Odometer Reading (KM)</label>
                        <input asp-for="OdometerReading" type="number" class="form-control" placeholder="45000" required />
                        <span asp-validation-for="OdometerReading" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PerformedBy" class="form-label text-secondary small fw-bold">Service Provider / Workshop</label>
                        <input asp-for="PerformedBy" class="form-control" placeholder="e.g. Official Dealer Garage" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label text-secondary small fw-bold">Maintenance Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Completed">Completed</option>
                            <option value="InProgress">In Progress</option>
                            <option value="Scheduled">Scheduled</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label text-secondary small fw-bold">Service Notes / Work Performed</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Replaced synthetic oil, filter, checked tire pressure..."></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <a asp-action="Index" class="btn btn-glass">Cancel</a>
                    <button type="submit" class="btn btn-glow px-4" id="submitBtn">
                        <i class="bi bi-tools me-1"></i> Save Maintenance Record
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const carSelect = document.getElementById('carSelect');
        const alertBox = document.getElementById('rentedCarAlert');
        const submitBtn = document.getElementById('submitBtn');

        function checkSelectedCar() {
            const opt = carSelect.options[carSelect.selectedIndex];
            const status = opt ? opt.getAttribute('data-status') : '';

            if (status === 'Rented') {
                alertBox.classList.remove('d-none');
                submitBtn.disabled = true;
            } else {
                alertBox.classList.add('d-none');
                submitBtn.disabled = false;
            }
        }

        carSelect.addEventListener('change', checkSelectedCar);
        checkSelectedCar();
    </script>
}
