@using Application.Providers
@model DashboardMetricsDto

@{
    ViewData["Title"] = "Executive ERP Dashboard";
}

<div class="d-flex flex-column gap-4">
    <!-- Header Hero Banner -->
    <div class="glass-card p-4 position-relative overflow-hidden border-0">
        <div class="row align-items-center relative-1">
            <div class="col-lg-8 mb-3 mb-lg-0">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1">
                        <i class="bi bi-shield-check me-1"></i> Live Enterprise Operations
                    </span>
                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 rounded-pill px-3 py-1">
                        <i class="bi bi-lightning-charge me-1"></i> Fast DDD Provider Engine
                    </span>
                </div>
                <h2 class="display-6 fw-extrabold mb-1">
                    Welcome back, <span class="text-gradient">@User.Identity?.Name</span>!
                </h2>
                <p class="text-secondary mb-0">
                    Real-time fleet utilization, contract ledgers, active revenue analytics, and vehicle status.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <div class="d-inline-flex flex-column align-items-lg-end gap-1">
                    <div class="fs-4 fw-extrabold text-white">@Model.FleetUtilizationPercentage%</div>
                    <div class="text-secondary small">Fleet Utilization Rate</div>
                    <div class="progress mt-2 w-100" style="height: 6px; width: 160px;">
                        <div class="progress-bar bg-gradient" role="progressbar" style="width: @Model.FleetUtilizationPercentage%; background: linear-gradient(90deg, #3b82f6, #8b5cf6);"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Top KPI Stat Grid -->
    <div class="row g-4">
        <!-- Total Revenue Card -->
        <div class="col-xl-3 col-md-6">
            <div class="kpi-widget kpi-success h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-secondary small fw-bold text-uppercase tracking-wider">Total Revenue</div>
                        <div class="fs-3 fw-extrabold text-gradient-emerald mt-1">@Model.TotalPaidAmount.ToString("C")</div>
                        <div class="text-secondary small mt-1">From @Model.TotalPaymentsCount completed payments</div>
                    </div>
                    <div class="kpi-icon">
                        <i class="bi bi-wallet2"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Contracts Card -->
        <div class="col-xl-3 col-md-6">
            <div class="kpi-widget kpi-warning h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-secondary small fw-bold text-uppercase tracking-wider">Active Rentals</div>
                        <div class="fs-3 fw-extrabold text-gradient-amber mt-1">@Model.ActiveRentals</div>
                        <div class="text-secondary small mt-1">Cars currently on road</div>
                    </div>
                    <div class="kpi-icon">
                        <i class="bi bi-car-front"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Available Fleet Card -->
        <div class="col-xl-3 col-md-6">
            <div class="kpi-widget h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-secondary small fw-bold text-uppercase tracking-wider">Available Fleet</div>
                        <div class="fs-3 fw-extrabold text-white mt-1">@Model.AvailableCarsCount / @Model.TotalCarsCount</div>
                        <div class="text-secondary small mt-1">Ready for booking</div>
                    </div>
                    <div class="kpi-icon">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Contracts Card -->
        <div class="col-xl-3 col-md-6">
            <div class="kpi-widget kpi-purple h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-secondary small fw-bold text-uppercase tracking-wider">Total Contracts</div>
                        <div class="fs-3 fw-extrabold text-white mt-1">@Model.TotalRentals</div>
                        <div class="text-secondary small mt-1">@Model.CompletedRentals completed | @Model.CancelledRentals cancelled</div>
                    </div>
                    <div class="kpi-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts & Metrics Analytics Section -->
    <div class="row g-4">
        <!-- Monthly Contracts Chart -->
        <div class="col-lg-6">
            <div class="glass-card p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-graph-up-arrow text-primary fs-5"></i>
                        <h5 class="fw-bold mb-0 text-white">Monthly Contract Velocity</h5>
                    </div>
                    <span class="badge bg-dark text-secondary border border-secondary border-opacity-25">Last 7 Months</span>
                </div>
                <div style="height: 280px;">
                    <canvas id="rentalsChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Monthly Revenue Chart -->
        <div class="col-lg-6">
            <div class="glass-card p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-currency-dollar text-success fs-5"></i>
                        <h5 class="fw-bold mb-0 text-white">Monthly Cash Flow</h5>
                    </div>
                    <span class="badge bg-dark text-secondary border border-secondary border-opacity-25">Last 7 Months</span>
                </div>
                <div style="height: 280px;">
                    <canvas id="paymentsChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Payment Transactions -->
    <div class="glass-card p-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-receipt-cutoff text-primary fs-5"></i>
                <h5 class="fw-bold mb-0 text-white">Recent Payment Transactions</h5>
            </div>
            <a asp-controller="Payment" asp-action="History" class="btn btn-glass btn-sm">
                View All Transactions <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        @if (Model.RecentPayments.Any())
        {
            <div class="table-responsive">
                <table class="table table-futuristic align-middle">
                    <thead>
                        <tr>
                            <th>Payment ID</th>
                            <th>Contract</th>
                            <th>Customer</th>
                            <th>Amount</th>
                            <th>Purpose</th>
                            <th>Method</th>
                            <th>Date</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model.RecentPayments)
                        {
                            <tr>
                                <td><span class="fw-bold text-primary">#PAY-@payment.Id.ToString("D4")</span></td>
                                <td><a asp-controller="Rentals" asp-action="Details" asp-route-rentalId="@payment.RentalContractId" class="text-gradient text-decoration-none fw-bold">#CNT-@payment.RentalContractId</a></td>
                                <td><span class="fw-semibold text-white">@payment.CustomerName</span></td>
                                <td><span class="fw-extrabold text-success">@payment.Amount.ToString("C")</span></td>
                                <td><span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25 px-3 py-1">@payment.Purpose</span></td>
                                <td><span class="badge bg-dark text-secondary border border-secondary border-opacity-25 px-3 py-1">@payment.Method</span></td>
                                <td><span class="text-secondary small">@payment.PaymentDate.ToString("MMM dd, yyyy HH:mm")</span></td>
                                <td class="text-end">
                                    <a asp-controller="Payment" asp-action="Receipt" asp-route-paymentId="@payment.Id" class="btn btn-glass btn-sm">
                                        <i class="bi bi-printer me-1"></i> Receipt
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-secondary">
                <i class="bi bi-inbox fs-1 d-block mb-2 text-muted"></i>
                <p class="mb-0">No payment transactions recorded yet.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <script>
        const chartOptions = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: {
                    grid: { color: 'rgba(255, 255, 255, 0.05)' },
                    ticks: { color: '#94a3b8' }
                },
                x: {
                    grid: { display: false },
                    ticks: { color: '#94a3b8' }
                }
            }
        };

        // Monthly Contract Velocity Line Chart
        new Chart(document.getElementById('rentalsChart').getContext('2d'), {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.Months)),
                datasets: [{
                    label: 'Contracts',
                    data: @Html.Raw(Json.Serialize(Model.RentalsPerMonth)),
                    borderColor: '#3b82f6',
                    backgroundColor: 'rgba(59, 130, 246, 0.15)',
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#3b82f6',
                    pointRadius: 5
                }]
            },
            options: chartOptions
        });

        // Monthly Cash Flow Bar Chart
        new Chart(document.getElementById('paymentsChart').getContext('2d'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.Months)),
                datasets: [{
                    label: 'Revenue',
                    data: @Html.Raw(Json.Serialize(Model.PaymentsPerMonth)),
                    backgroundColor: 'rgba(16, 185, 129, 0.7)',
                    borderColor: '#10b981',
                    borderRadius: 6,
                    borderWidth: 1
                }]
            },
            options: chartOptions
        });
    </script>
}