@model Application.Services.DTOs.RegisterDto
@using System.Globalization
@inject Web.Services.ILocalizationService Loc

@{
    ViewData["Title"] = "Create Account";
    var currentUICulture = CultureInfo.CurrentUICulture.Name;
    var isArabic = currentUICulture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
}

<div class="auth-page-container">
    <div class="auth-page-bg"></div>
    <div class="auth-grid-overlay"></div>

    <!-- Central Professional Register Card -->
    <div class="auth-card-wrapper">
        <div class="glass-card p-4 p-sm-5 border border-secondary border-opacity-25 shadow-2xl">
            <!-- Brand Badge -->
            <div class="auth-brand-badge">
                <i class="bi bi-person-plus-fill"></i>
            </div>

            <div class="text-center mb-4">
                <h3 class="fw-extrabold text-white mb-1 tracking-tight">
                    @(isArabic ? "إنشاء حساب جديد" : "Create Account")
                </h3>
                <p class="text-secondary small mb-0">
                    @(isArabic ? "انضم إلى منظومة إدارة وتأجير أسطول السيارات" : "Join CarRental ERP System Management")
                </p>
            </div>

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger bg-danger bg-opacity-15 border-0 text-danger rounded-3 py-2 px-3 mb-3 small @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label text-secondary small fw-bold mb-1.5">
                        @(isArabic ? "الاسم الكامل" : "Full Name")
                    </label>
                    <div class="input-group auth-input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input asp-for="Name" class="form-control" placeholder="John Doe" required autofocus />
                    </div>
                    <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label text-secondary small fw-bold mb-1.5">
                        @(isArabic ? "البريد الإلكتروني" : "Email Address")
                    </label>
                    <div class="input-group auth-input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" type="email" class="form-control" placeholder="john@company.com" required />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label text-secondary small fw-bold mb-1.5">
                        @(isArabic ? "رقم الهاتف" : "Phone Number")
                    </label>
                    <div class="input-group auth-input-group">
                        <span class="input-group-text"><i class="bi bi-phone"></i></span>
                        <input asp-for="Phone" type="tel" class="form-control" placeholder="+1 (555) 019-2834" required />
                    </div>
                    <span asp-validation-for="Phone" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label text-secondary small fw-bold mb-1.5">
                        @(isArabic ? "كلمة المرور" : "Password")
                    </label>
                    <div class="input-group auth-input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label text-secondary small fw-bold mb-1.5">
                        @(isArabic ? "تأكيد كلمة المرور" : "Confirm Password")
                    </label>
                    <div class="input-group auth-input-group">
                        <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" required />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                </div>

                <button type="submit" class="btn btn-glow w-100 py-3 fw-bold d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-person-check-fill fs-5"></i>
                    <span>@(isArabic ? "تسجيل الحساب" : "Register Account")</span>
                </button>
            </form>

            <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25 small text-secondary">
                <span>@(isArabic ? "لديك حساب بالفعل؟" : "Already registered?")</span>
                <a asp-action="Login" class="text-gradient fw-bold text-decoration-none ms-1">
                    @(isArabic ? "تسجيل الدخول" : "Sign In")
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}