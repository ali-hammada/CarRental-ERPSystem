@model IEnumerable<Web.ViewModels.EmployeeVM>

@{
    ViewData["Title"] = "User Roles & Permissions Control Center";
    var totalUsers = Model.Count();
    var adminCount = Model.Count(e => e.Role.Equals("Admin", StringComparison.OrdinalIgnoreCase) || e.Role.Equals("Administrator", StringComparison.OrdinalIgnoreCase));
    var managerCount = Model.Count(e => e.Role.Equals("Manager", StringComparison.OrdinalIgnoreCase));
    var employeeCount = Model.Count(e => e.Role.Equals("Employee", StringComparison.OrdinalIgnoreCase));
    var suspendedCount = Model.Count(e => !e.IsActive);
}

<div class="d-flex flex-column gap-4">
    <!-- Header Hero Banner -->
    <div class="glass-card p-4 position-relative overflow-hidden border-0">
        <div class="row align-items-center relative-1">
            <div class="col-lg-8 mb-3 mb-lg-0">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-25 rounded-pill px-3 py-1">
                        <i class="bi bi-shield-lock-fill me-1"></i> System Security & Access Control
                    </span>
                    <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-25 rounded-pill px-3 py-1">
                        <i class="bi bi-key-fill me-1"></i> Admin Privileged Zone
                    </span>
                </div>
                <h2 class="display-6 fw-extrabold mb-1 text-white">
                    User Roles & Permissions Control Center
                </h2>
                <p class="text-secondary mb-0">
                    Assign administrative privileges, update staff roles, manage system permissions, and control user account access.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a asp-action="Create" class="btn btn-glow">
                    <i class="bi bi-person-plus-fill me-1"></i> Add New Staff Member
                </a>
            </div>
        </div>

        <!-- Quick Stats Strip -->
        <div class="row g-3 mt-3 pt-3 border-top border-secondary border-opacity-25">
            <div class="col-6 col-md-3">
                <div class="d-flex align-items-center gap-3 bg-dark bg-opacity-50 p-2.5 rounded-3 border border-secondary border-opacity-25">
                    <div class="rounded-circle bg-primary bg-opacity-25 text-primary p-2 fs-5 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-people"></i>
                    </div>
                    <div>
                        <div class="fs-5 fw-extrabold text-white">@totalUsers</div>
                        <div class="text-secondary small">Total System Users</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="d-flex align-items-center gap-3 bg-dark bg-opacity-50 p-2.5 rounded-3 border border-secondary border-opacity-25">
                    <div class="rounded-circle bg-warning bg-opacity-25 text-warning p-2 fs-5 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <div>
                        <div class="fs-5 fw-extrabold text-warning">@adminCount</div>
                        <div class="text-secondary small">System Administrators</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="d-flex align-items-center gap-3 bg-dark bg-opacity-50 p-2.5 rounded-3 border border-secondary border-opacity-25">
                    <div class="rounded-circle bg-info bg-opacity-25 text-info p-2 fs-5 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-briefcase"></i>
                    </div>
                    <div>
                        <div class="fs-5 fw-extrabold text-info">@managerCount</div>
                        <div class="text-secondary small">Operational Managers</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="d-flex align-items-center gap-3 bg-dark bg-opacity-50 p-2.5 rounded-3 border border-secondary border-opacity-25">
                    <div class="rounded-circle bg-danger bg-opacity-25 text-danger p-2 fs-5 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-slash-circle"></i>
                    </div>
                    <div>
                        <div class="fs-5 fw-extrabold text-danger">@suspendedCount</div>
                        <div class="text-secondary small">Suspended Accounts</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Role Permissions Scope Breakdown Accordion -->
    <div class="glass-card p-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-grid-3x3-gap-fill text-primary fs-5"></i>
                <h5 class="fw-bold mb-0 text-white">Role Permission Privilege Matrix</h5>
            </div>
            <span class="badge bg-dark text-secondary border border-secondary border-opacity-25">Standard Roles</span>
        </div>

        <div class="row g-3">
            <div class="col-md-3">
                <div class="p-3 bg-dark bg-opacity-40 rounded-3 border border-warning border-opacity-25 h-100">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-warning text-dark fw-bold px-2.5 py-1">Admin</span>
                        <span class="text-white small fw-bold">System Administrator</span>
                    </div>
                    <ul class="list-unstyled text-secondary small mb-0 d-flex flex-column gap-1">
                        <li><i class="bi bi-check2 text-success me-1"></i> Full System-Wide Access</li>
                        <li><i class="bi bi-check2 text-success me-1"></i> Staff & Roles Management</li>
                        <li><i class="bi bi-check2 text-success me-1"></i> View All Contracts & Revenue</li>
                        <li><i class="bi bi-check2 text-success me-1"></i> Audit Trail & Telemetry</li>
                    </ul>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-dark bg-opacity-40 rounded-3 border border-info border-opacity-25 h-100">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-info text-dark fw-bold px-2.5 py-1">Manager</span>
                        <span class="text-white small fw-bold">Operations Manager</span>
                    </div>
                    <ul class="list-unstyled text-secondary small mb-0 d-flex flex-column gap-1">
                        <li><i class="bi bi-check2 text-success me-1"></i> All Rentals & Customer CRM</li>
                        <li><i class="bi bi-check2 text-success me-1"></i> Fleet Maintenance & Live GPS</li>
                        <li><i class="bi bi-check2 text-success me-1"></i> Financial Reports & Tax Invoices</li>
                        <li><i class="bi bi-x text-danger me-1"></i> No Staff Permission Editing</li>
                    </ul>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-dark bg-opacity-40 rounded-3 border border-success border-opacity-25 h-100">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-success text-white fw-bold px-2.5 py-1">Accountant</span>
                        <span class="text-white small fw-bold">Financial Accountant</span>
                    </div>
                    <ul class="list-unstyled text-secondary small mb-0 d-flex flex-column gap-1">
                        <li><i class="bi bi-check2 text-success me-1"></i> Payment Ledger & Receipts</li>
                        <li><i class="bi bi-check2 text-success me-1"></i> Tax Invoices & Collections</li>
                        <li><i class="bi bi-check2 text-success me-1"></i> Contract Financial Details</li>
                        <li><i class="bi bi-x text-danger me-1"></i> No Fleet Status Changes</li>
                    </ul>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-dark bg-opacity-40 rounded-3 border border-secondary border-opacity-25 h-100">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-secondary text-white fw-bold px-2.5 py-1">Employee</span>
                        <span class="text-white small fw-bold">Rental Agent</span>
                    </div>
                    <ul class="list-unstyled text-secondary small mb-0 d-flex flex-column gap-1">
                        <li><i class="bi bi-check2 text-success me-1"></i> Create & View Own Contracts</li>
                        <li><i class="bi bi-check2 text-success me-1"></i> Register Customers & Payments</li>
                        <li><i class="bi bi-check2 text-success me-1"></i> View Available Fleet</li>
                        <li><i class="bi bi-x text-danger me-1"></i> Restricted to Own Operations</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- User Accounts & Roles Table -->
    <div class="glass-card p-4">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-lines-fill text-warning fs-5"></i>
                <h5 class="fw-bold mb-0 text-white">Staff Accounts & Permission Assignment</h5>
            </div>
            <a asp-action="Index" class="btn btn-glass btn-sm">
                <i class="bi bi-list-ul me-1"></i> View Standard Directory
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-futuristic align-middle mb-0">
                <thead>
                    <tr>
                        <th>User ID</th>
                        <th>User Profile</th>
                        <th>Contact</th>
                        <th>Current Role</th>
                        <th>Access Status</th>
                        <th>Assign Role</th>
                        <th class="text-end">Security Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var isAdmin = user.Role.Equals("Admin", StringComparison.OrdinalIgnoreCase) || user.Role.Equals("Administrator", StringComparison.OrdinalIgnoreCase);
                        var isManager = user.Role.Equals("Manager", StringComparison.OrdinalIgnoreCase);
                        var isAccountant = user.Role.Equals("Accountant", StringComparison.OrdinalIgnoreCase);
                        <tr>
                            <td><span class="fw-bold text-primary">#USR-@user.Id.ToString("D4")</span></td>
                            <td>
                                <div class="d-flex align-items-center gap-2.5">
                                    <div class="rounded-circle bg-primary bg-opacity-25 text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                        @user.FullName.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <span class="fw-bold text-white d-block">@user.FullName</span>
                                        <span class="text-secondary small">ID: #@user.Id</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div>
                                    <span class="text-white small d-block"><i class="bi bi-envelope me-1 text-secondary"></i>@user.Email</span>
                                    <span class="text-secondary small"><i class="bi bi-telephone me-1 text-secondary"></i>@user.Phone</span>
                                </div>
                            </td>
                            <td>
                                @if (isAdmin)
                                {
                                    <span class="badge bg-warning text-dark fw-bold px-3 py-1 border border-warning">
                                        <i class="bi bi-shield-check me-1"></i> Admin
                                    </span>
                                }
                                else if (isManager)
                                {
                                    <span class="badge bg-info text-dark fw-bold px-3 py-1 border border-info">
                                        <i class="bi bi-briefcase me-1"></i> Manager
                                    </span>
                                }
                                else if (isAccountant)
                                {
                                    <span class="badge bg-success text-white fw-bold px-3 py-1 border border-success">
                                        <i class="bi bi-cash-coin me-1"></i> Accountant
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-white fw-bold px-3 py-1 border border-secondary">
                                        <i class="bi bi-person me-1"></i> Employee
                                    </span>
                                }
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 px-2.5 py-1">
                                        <i class="bi bi-check-circle me-1"></i> Active Access
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-25 px-2.5 py-1">
                                        <i class="bi bi-dash-circle me-1"></i> Suspended
                                    </span>
                                }
                            </td>
                            <td>
                                <form asp-action="UpdateRole" method="post" class="d-flex align-items-center gap-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <select name="role" class="form-select form-select-sm bg-dark text-white border-secondary border-opacity-25" style="width: 130px;" onchange="this.form.submit()">
                                        <option value="Admin" selected="@(isAdmin)">Admin</option>
                                        <option value="Manager" selected="@(isManager)">Manager</option>
                                        <option value="Accountant" selected="@(isAccountant)">Accountant</option>
                                        <option value="Employee" selected="@(!isAdmin && !isManager && !isAccountant)">Employee</option>
                                    </select>
                                </form>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex align-items-center gap-2">
                                    <!-- Toggle Active Button -->
                                    <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        @if (user.IsActive)
                                        {
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Suspend User Access">
                                                <i class="bi bi-slash-circle me-1"></i> Suspend
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-outline-success btn-sm" title="Activate User Access">
                                                <i class="bi bi-check-circle me-1"></i> Activate
                                            </button>
                                        }
                                    </form>

                                    <!-- Quick Password Reset Button -->
                                    <button type="button" class="btn btn-glass btn-sm" data-bs-toggle="modal" data-bs-target="#resetModal-@user.Id" title="Reset Password">
                                        <i class="bi bi-key text-warning"></i>
                                    </button>

                                    <!-- Edit Profile -->
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-glass btn-sm" title="Edit Full Profile">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>

                                <!-- Password Reset Modal -->
                                <div class="modal fade" id="resetModal-@user.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content glass-card text-start">
                                            <div class="modal-header border-secondary border-opacity-25">
                                                <h5 class="modal-title fw-bold text-white"><i class="bi bi-key text-warning me-2"></i> Reset Password for @user.FullName</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <form asp-action="QuickResetPassword" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label class="form-label text-secondary small fw-bold">New Password</label>
                                                        <input type="password" name="newPassword" class="form-control" placeholder="Enter new password (min 6 chars)" required minlength="6" />
                                                    </div>
                                                </div>
                                                <div class="modal-footer border-secondary border-opacity-25">
                                                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-glow">Save New Password</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
