@model Application.DTOs.CarSaleListDto

@{
    Layout = null;
    var installments = ViewBag.Installments as IEnumerable<Application.DTOs.SaleInstallmentDto> ?? new List<Application.DTOs.SaleInstallmentDto>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bill of Sale #SALE-@Model.Id.ToString("D4") - Official Agreement</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
            color: #212529;
        }

        .contract-paper {
            background-color: #ffffff;
            max-width: 850px;
            margin: 30px auto;
            padding: 40px;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            border: 1px solid #dee2e6;
        }

        .header-logo {
            border-bottom: 2px solid #198754;
            padding-bottom: 15px;
            margin-bottom: 25px;
        }

        .company-title {
            font-size: 24px;
            font-weight: 800;
            color: #198754;
            letter-spacing: -0.5px;
        }

        .section-header {
            background-color: #f1f5f9;
            padding: 8px 14px;
            font-weight: 700;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-left: 4px solid #198754;
            margin-bottom: 15px;
            color: #334155;
        }

        .info-table td {
            padding: 6px 10px;
            font-size: 14px;
        }

        .info-label {
            font-weight: 600;
            color: #64748b;
            width: 35%;
        }

        .signature-box {
            border-top: 1px dashed #cbd5e1;
            padding-top: 60px;
            margin-top: 50px;
        }

        .terms-text {
            font-size: 11px;
            color: #64748b;
            line-height: 1.5;
        }

        @@media print {
            body {
                background-color: #ffffff !important;
            }

            .no-print {
                display: none !important;
            }

            .contract-paper {
                box-shadow: none !important;
                border: none !important;
                margin: 0 !important;
                padding: 20px !important;
                max-width: 100% !important;
            }
        }
    </style>
</head>
<body>

    <!-- Top Action Toolbar (Hidden during Print) -->
    <div class="no-print bg-dark text-white py-3 mb-3 shadow-sm">
        <div class="container d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-printer-fill text-warning fs-5"></i>
                <span class="fw-bold">Printable Official Vehicle Bill of Sale Agreement</span>
            </div>
            <div class="d-flex gap-2">
                <button onclick="window.print()" class="btn btn-warning btn-sm fw-bold">
                    <i class="bi bi-printer me-1"></i> Print / Save as PDF
                </button>
                <button onclick="window.close()" class="btn btn-outline-light btn-sm">
                    Close Window
                </button>
            </div>
        </div>
    </div>

    <!-- Official Printable Contract Paper -->
    <div class="contract-paper">
        <!-- Header -->
        <div class="header-logo d-flex align-items-center justify-content-between">
            <div>
                <div class="company-title"><i class="bi bi-tag-fill me-2"></i>CAR RENTAL & DEALERSHIP ENTERPRISE</div>
                <div class="text-secondary small">Official Vehicle Purchase Agreement & Ownership Transfer Contract</div>
            </div>
            <div class="text-end">
                <span class="badge bg-success text-white px-3 py-2 fs-6">BILL OF SALE #SALE-@Model.Id.ToString("D4")</span>
                <div class="text-secondary small mt-1">Sale Date: @Model.SaleDate.ToString("yyyy-MM-dd")</div>
            </div>
        </div>

        <!-- Details Grid -->
        <div class="row g-4 mb-4">
            <!-- Customer Buyer Profile -->
            <div class="col-6">
                <div class="section-header"><i class="bi bi-person-fill me-1"></i> Buyer Customer Information</div>
                <table class="w-100 info-table">
                    <tr>
                        <td class="info-label">Full Name:</td>
                        <td class="fw-bold">@Model.CustomerName</td>
                    </tr>
                    <tr>
                        <td class="info-label">Phone Number:</td>
                        <td>@Model.CustomerPhone</td>
                    </tr>
                    <tr>
                        <td class="info-label">Customer ID:</td>
                        <td>#CUST-@Model.CustomerId.ToString("D4")</td>
                    </tr>
                </table>
            </div>

            <!-- Vehicle Sold -->
            <div class="col-6">
                <div class="section-header"><i class="bi bi-car-front me-1"></i> Sold Vehicle Specifications</div>
                <table class="w-100 info-table">
                    <tr>
                        <td class="info-label">Car Model:</td>
                        <td class="fw-bold">@Model.CarModel</td>
                    </tr>
                    <tr>
                        <td class="info-label">Plate Number:</td>
                        <td><span class="badge bg-light text-dark border border-secondary px-2">@Model.CarPlateNumber</span></td>
                    </tr>
                    <tr>
                        <td class="info-label">Authorized Agent:</td>
                        <td class="fw-semibold">@Model.EmployeeName</td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- Financial Breakdown Table -->
        <div class="section-header"><i class="bi bi-cash-stack me-1"></i> Financial Settlement & Financing Terms</div>
        <table class="table table-bordered align-middle mb-4 small">
            <thead class="table-light">
                <tr>
                    <th>Description</th>
                    <th class="text-end">Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Base Vehicle Agreed Selling Price</td>
                    <td class="text-end font-monospace">@Model.SalePrice.ToString("C")</td>
                </tr>
                <tr>
                    <td>Sales VAT / Tax (14%)</td>
                    <td class="text-end font-monospace text-warning">@Model.TaxAmount.ToString("C")</td>
                </tr>
                <tr class="table-secondary fw-bold">
                    <td>Total Final Purchase Price</td>
                    <td class="text-end font-monospace">@Model.FinalPrice.ToString("C")</td>
                </tr>
                <tr>
                    <td class="text-success">Initial Down Payment / Amount Paid</td>
                    <td class="text-end font-monospace text-success fw-bold">@Model.PaidAmount.ToString("C")</td>
                </tr>
                <tr class="fw-bold">
                    <td>Remaining Balance Due</td>
                    <td class="text-end font-monospace @(Model.RemainingBalance > 0 ? "text-danger" : "text-success") fs-6">
                        @Model.RemainingBalance.ToString("C")
                    </td>
                </tr>
            </tbody>
        </table>

        <!-- Installment Schedule Summary (If Installment) -->
        @if (Model.PaymentType == ApplicationCore.Enums.SalePaymentType.Installment && installments.Any())
        {
            <div class="section-header"><i class="bi bi-calendar-check me-1"></i> Installments Financing Schedule (@Model.InstallmentMonths Months)</div>
            <table class="table table-sm table-bordered align-middle mb-4 small">
                <thead class="table-light">
                    <tr>
                        <th>Installment #</th>
                        <th>Due Date</th>
                        <th class="text-end">Monthly Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inst in installments)
                    {
                        <tr>
                            <td>#Q-@inst.InstallmentNumber</td>
                            <td>@inst.DueDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-end font-monospace">@inst.Amount.ToString("C")</td>
                            <td><span class="badge @(inst.Status == ApplicationCore.Enums.InstallmentStatus.Paid ? "bg-success" : "bg-warning text-dark")">@inst.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <!-- Terms & Conditions -->
        <div class="mb-4">
            <div class="fw-bold small mb-1 text-uppercase text-secondary">Bill of Sale Terms & Transfer Warranties:</div>
            <div class="terms-text border p-2.5 rounded bg-light">
                1. The Seller hereby transfers all title, ownership, and rights of the vehicle to the Buyer upon full settlement.<br />
                2. The vehicle is sold in "as-is" condition after physical inspection by the Buyer.<br />
                3. For financed/installment sales, full title transfer is completed upon payment of the final installment.<br />
                4. Late installment payments exceeding 10 days will incur late processing fees as per financing regulations.
            </div>
        </div>

        <!-- Dual Signature Lines -->
        <div class="signature-box">
            <div class="row text-center">
                <div class="col-6">
                    <div class="fw-bold text-dark mb-1">Buyer Signature</div>
                    <div class="text-secondary small">I accept the vehicle and agree to all sale terms</div>
                </div>
                <div class="col-6">
                    <div class="fw-bold text-dark mb-1">Dealership Authorized Officer</div>
                    <div class="text-secondary small">Stamp & Official Transfer Verification</div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
