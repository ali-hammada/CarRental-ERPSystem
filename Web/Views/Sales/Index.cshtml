@model IEnumerable<Application.DTOs.CarSaleListDto>

@{
    ViewData["Title"] = "Dealership Sales Ledger";
    var totalSalesValue = Model.Sum(s => s.FinalPrice);
    var totalCollected = Model.Sum(s => s.PaidAmount);
    var totalReceivable = Model.Sum(s => s.RemainingBalance);
    var totalGrossProfit = Model.Sum(s => s.ActualGrossProfit);
    var cashCount = Model.Count(s => s.PaymentType == ApplicationCore.Enums.SalePaymentType.Cash);
    var installmentCount = Model.Count(s => s.PaymentType == ApplicationCore.Enums.SalePaymentType.Installment);
}

<div class="d-flex flex-column gap-4">
    <!-- Header Hero Banner -->
    <div class="glass-card p-4 position-relative overflow-hidden border-0">
        <div class="row align-items-center relative-1">
            <div class="col-lg-8 mb-3 mb-lg-0">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 rounded-pill px-3 py-1">
                        <i class="bi bi-tag-fill me-1"></i> Dealership Sales & Financing
                    </span>
                    <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1">
                        <i class="bi bi-shield-check me-1"></i> Enterprise Sales Ledger
                    </span>
                </div>
                <h2 class="display-6 fw-extrabold mb-1 text-white">
                    Car Sales & Profitability Operations
                </h2>
                <p class="text-secondary mb-0">
                    Manage dealership car sales, cost basis tracking, smart negotiation floor limits, and gross profit margins.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a asp-action="Create" class="btn btn-glow btn-lg">
                    <i class="bi bi-plus-circle-fill me-1"></i> Sell Vehicle (New Sale)
                </a>
            </div>
        </div>

        <!-- KPI Strip -->
        <div class="row g-3 mt-3 pt-3 border-top border-secondary border-opacity-25">
            <div class="col-6 col-md-3">
                <div class="p-3 bg-dark bg-opacity-50 rounded-3 border border-secondary border-opacity-25">
                    <div class="text-secondary small fw-bold mb-1">TOTAL SALES VALUE</div>
                    <div class="fs-4 fw-extrabold text-white">@totalSalesValue.ToString("C")</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 bg-dark bg-opacity-50 rounded-3 border border-secondary border-opacity-25">
                    <div class="text-secondary small fw-bold mb-1">NET GROSS PROFIT</div>
                    <div class="fs-4 fw-extrabold text-success">@totalGrossProfit.ToString("C")</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 bg-dark bg-opacity-50 rounded-3 border border-secondary border-opacity-25">
                    <div class="text-secondary small fw-bold mb-1">INSTALLMENTS RECEIVABLE</div>
                    <div class="fs-4 fw-extrabold text-warning">@totalReceivable.ToString("C")</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 bg-dark bg-opacity-50 rounded-3 border border-secondary border-opacity-25">
                    <div class="text-secondary small fw-bold mb-1">CASH / FINANCING RATIO</div>
                    <div class="fs-5 fw-extrabold text-info">@cashCount Cash | @installmentCount Installments</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sales Contracts Data Grid -->
    <div class="glass-card p-4">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h5 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-journal-text text-primary"></i> Vehicle Sales Contracts (@Model.Count())
            </h5>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5 text-secondary">
                <i class="bi bi-tag fs-1 text-muted d-block mb-3 opacity-50"></i>
                <h5 class="fw-bold">No Vehicle Sales Recorded Yet</h5>
                <p class="small text-muted">Click "Sell Vehicle" to open your first car sales contract.</p>
                <a asp-action="Create" class="btn btn-glow mt-2">
                    <i class="bi bi-plus-circle me-1"></i> Open First Sale Contract
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-futuristic align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Contract ID</th>
                            <th>Sold Vehicle</th>
                            <th>Buyer Customer</th>
                            <th>Sale Date</th>
                            <th>Type</th>
                            <th>Final Price</th>
                            <th>Paid Amount</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td><span class="fw-bold text-primary">#SALE-@s.Id.ToString("D4")</span></td>
                                <td>
                                    <div class="fw-bold text-white">@s.CarModel</div>
                                    <div class="text-secondary small">Plate: @s.CarPlateNumber</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-white">@s.CustomerName</div>
                                    <div class="text-secondary small"><i class="bi bi-telephone me-1"></i>@s.CustomerPhone</div>
                                </td>
                                <td><span class="text-secondary small">@s.SaleDate.ToString("MMM dd, yyyy")</span></td>
                                <td>
                                    @if (s.PaymentType == ApplicationCore.Enums.SalePaymentType.Cash)
                                    {
                                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 px-2.5 py-1">
                                            <i class="bi bi-cash me-1"></i> Cash Sale
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-25 px-2.5 py-1">
                                            <i class="bi bi-calendar-check me-1"></i> Installments (@s.InstallmentMonths Mo)
                                        </span>
                                    }
                                </td>
                                <td><span class="fw-bold text-white">@s.FinalPrice.ToString("C")</span></td>
                                <td><span class="fw-bold text-success">@s.PaidAmount.ToString("C")</span></td>
                                <td>
                                    @if (s.Status == ApplicationCore.Enums.SaleContractStatus.Completed)
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }
                                    else if (s.Status == ApplicationCore.Enums.SaleContractStatus.Active)
                                    {
                                        <span class="badge bg-info">Active Installments</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Cancelled</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-glass btn-sm" title="View Details & Installments">
                                            <i class="bi bi-eye text-primary"></i>
                                        </a>
                                        <a asp-action="PrintSaleAgreement" asp-route-id="@s.Id" target="_blank" class="btn btn-glass btn-sm" title="Print Bill of Sale Contract">
                                            <i class="bi bi-printer text-warning"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
