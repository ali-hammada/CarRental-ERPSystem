@{
    ViewData["Title"] = "Make Payment";
    var rentalId = (int)ViewBag.RentalId;
    var remainingAmount = (decimal)ViewBag.RemainingAmount;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="glass-card p-4">
            <div class="d-flex align-items-center gap-3 border-bottom border-secondary border-opacity-25 pb-3 mb-4">
                <div class="kpi-icon bg-success bg-opacity-25 text-success">
                    <i class="bi bi-wallet2"></i>
                </div>
                <div>
                    <h4 class="fw-bold text-white mb-0">Record Contract Payment</h4>
                    <p class="text-secondary small mb-0">Contract #CNT-@rentalId.ToString("D5") Settlement</p>
                </div>
            </div>

            <!-- Remaining Amount Card -->
            <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25 mb-4 d-flex align-items-center justify-content-between">
                <div class="text-secondary">Outstanding Balance Due:</div>
                <div class="fs-3 fw-extrabold text-gradient-emerald">@remainingAmount.ToString("C")</div>
            </div>

            <form asp-action="MakePayment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="rentalId" value="@rentalId" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="purpose" class="form-label text-secondary small fw-bold">Payment Purpose</label>
                        <select name="purpose" id="purpose" class="form-select" required>
                            <option value="">Select purpose...</option>
                            <option value="@PaymentPurpose.Partial">Partial Settlement</option>
                            <option value="@PaymentPurpose.Final">Final Full Settlement</option>
                            <option value="@PaymentPurpose.Penalty">Penalty / Damage Charge</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label for="method" class="form-label text-secondary small fw-bold">Payment Method</label>
                        <select name="method" id="method" class="form-select" required>
                            <option value="">Select method...</option>
                            <option value="@PaymentMethod.Cash">Cash</option>
                            <option value="@PaymentMethod.CreditCard">Credit Card</option>
                            <option value="@PaymentMethod.DebitCard">Debit Card</option>
                            <option value="@PaymentMethod.BankTransfer">Bank Wire Transfer</option>
                            <option value="@PaymentMethod.OnlineGateway">Online Payment Gateway</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label for="amount" class="form-label text-secondary small fw-bold">Payment Amount ($)</label>
                        <input type="number" name="amount" id="amount" class="form-control" step="0.01" min="0.01" placeholder="0.00" required />
                        <small class="form-text text-secondary mt-1" id="amountHelp"></small>
                    </div>

                    <div class="col-md-6">
                        <label for="transactionRef" class="form-label text-secondary small fw-bold">Transaction Reference / Receipt #</label>
                        <input type="text" name="transactionRef" id="transactionRef" class="form-control" placeholder="e.g. TXN-984201" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <a asp-controller="Rentals" asp-action="Index" class="btn btn-glass">Cancel</a>
                    <button type="submit" class="btn btn-glow px-4">
                        <i class="bi bi-check-lg me-1"></i> Submit Payment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const remainingAmount = @Html.Raw(Json.Serialize(remainingAmount));
        const PaymentPurpose = {
            Partial: @((int)PaymentPurpose.Partial),
            Final: @((int)PaymentPurpose.Final),
            Penalty: @((int)PaymentPurpose.Penalty)
        };

        const purposeSelect = document.getElementById('purpose');
        const amountInput = document.getElementById('amount');
        const amountHelp = document.getElementById('amountHelp');

        purposeSelect.addEventListener('change', function() {
            const purpose = parseInt(this.value);
            if (purpose === PaymentPurpose.Final) {
                amountInput.value = remainingAmount;
                amountHelp.textContent = `Required final amount: ${formatCurrency(remainingAmount)}`;
            } else if (purpose === PaymentPurpose.Partial) {
                amountHelp.textContent = `Up to: ${formatCurrency(remainingAmount)}`;
            } else {
                amountHelp.textContent = 'Enter penalty or extra fee amount';
            }
        });

        function formatCurrency(value) {
            return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(value);
        }
    </script>
}
