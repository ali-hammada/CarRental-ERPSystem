@model IEnumerable<RentalListDto>

@{
    ViewData["Title"] = "Contract Payments & Ledger";
}

<div class="d-flex flex-column gap-4">
    <!-- Header Banner -->
    <div class="glass-card p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 rounded-pill px-3 py-1">
                    <i class="bi bi-wallet2 me-1"></i> Payment Management
                </span>
                <span class="text-secondary small">Contracts Requiring Settlement</span>
            </div>
            <h2 class="fw-extrabold mb-0 text-white">Payment Ledger & Receipts</h2>
        </div>
        <a asp-action="History" class="btn btn-glass">
            <i class="bi bi-clock-history me-1"></i> View All Transactions
        </a>
    </div>

    <!-- Payments Ledger Card -->
    <div class="glass-card p-4">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-secondary">
                <i class="bi bi-check2-all fs-1 d-block mb-3 text-success"></i>
                <h4 class="text-white fw-bold">All contracts fully settled</h4>
                <p class="mb-4">There are no outstanding balances or pending payments.</p>
                <a asp-controller="Rentals" asp-action="Index" class="btn btn-glow">
                    <i class="bi bi-file-earmark-text me-1"></i> View Contracts
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-futuristic align-middle">
                    <thead>
                        <tr>
                            <th>Contract ID</th>
                            <th>Vehicle Model</th>
                            <th>Customer Name</th>
                            <th>Total Amount</th>
                            <th>Paid Amount</th>
                            <th>Remaining Balance</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rental in Model)
                        {
                            var total = rental.FinalAmount ?? rental.TotalAmount;
                            var remaining = total - rental.PaidAmount;
                            <tr>
                                <td>
                                    <a asp-controller="Rentals" asp-action="Details" asp-route-rentalId="@rental.Id" class="fw-bold text-primary text-decoration-none">
                                        #CNT-@rental.Id.ToString("D5")
                                    </a>
                                </td>
                                <td>
                                    <div class="fw-bold text-white">@rental.CarModel</div>
                                    <span class="text-secondary small">@rental.CarPlateNumber</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-white">@rental.CustomerName</div>
                                    <span class="text-secondary small">@rental.CustomerPhone</span>
                                </td>
                                <td><span class="fw-bold text-white">@total.ToString("C")</span></td>
                                <td><span class="fw-bold text-success">@rental.PaidAmount.ToString("C")</span></td>
                                <td>
                                    @if (remaining > 0)
                                    {
                                        <span class="fw-extrabold text-danger">@remaining.ToString("C")</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25">Paid in Full</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        @if (remaining > 0)
                                        {
                                            <a asp-action="MakePayment" asp-route-rentalId="@rental.Id" class="btn btn-glow btn-sm">
                                                <i class="bi bi-cash me-1"></i> Pay
                                            </a>
                                        }
                                        <a asp-action="History" asp-route-rentalId="@rental.Id" class="btn btn-glass btn-sm" title="Payment History">
                                            <i class="bi bi-list-ul"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>