<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Enterprise CarRental ERP</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <!-- Enterprise Data Grid Dependencies (DataTables / Kendo Engine) -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <div class="app-wrapper" id="appWrapper">
        <!-- Collapsible Glassmorphic Sidebar -->
        <aside class="sidebar-wrapper" id="sidebarMenu">
            <div class="sidebar-header">
                <a class="sidebar-brand" asp-controller="Home" asp-action="Dashboard">
                    <div class="sidebar-brand-icon">
                        <i class="bi bi-car-front-fill"></i>
                    </div>
                    <span class="sidebar-brand-text text-gradient">CarRental<span class="text-white">ERP</span></span>
                </a>
            </div>

            <nav class="sidebar-nav">
                <a class="sidebar-link" asp-controller="Home" asp-action="Dashboard" title="Dashboard">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span class="sidebar-link-text">Dashboard</span>
                </a>
                <a class="sidebar-link" asp-controller="Car" asp-action="Index" title="Fleet Catalog">
                    <i class="bi bi-car-front-fill"></i>
                    <span class="sidebar-link-text">Fleet Catalog</span>
                </a>
                <a class="sidebar-link" asp-controller="Rentals" asp-action="Index" title="Rental Contracts">
                    <i class="bi bi-file-earmark-text-fill"></i>
                    <span class="sidebar-link-text">Rental Contracts</span>
                </a>
                <a class="sidebar-link" asp-controller="Customers" asp-action="Index" title="Customers">
                    <i class="bi bi-people-fill"></i>
                    <span class="sidebar-link-text">Customers</span>
                </a>
                <a class="sidebar-link" asp-controller="Payment" asp-action="Index" title="Payment Ledger">
                    <i class="bi bi-wallet2"></i>
                    <span class="sidebar-link-text">Payment Ledger</span>
                </a>
                <a class="sidebar-link" asp-controller="Invoices" asp-action="Index" title="Tax Invoices">
                    <i class="bi bi-receipt-cutoff"></i>
                    <span class="sidebar-link-text">Tax Invoices</span>
                </a>
                <a class="sidebar-link" asp-controller="Maintenance" asp-action="Index" title="Maintenance">
                    <i class="bi bi-tools"></i>
                    <span class="sidebar-link-text">Maintenance</span>
                </a>
                <a class="sidebar-link" asp-controller="Tracking" asp-action="Index" title="GPS Live Tracking">
                    <i class="bi bi-broadcast text-primary"></i>
                    <span class="sidebar-link-text">GPS Live Tracking</span>
                </a>
                <a class="sidebar-link" asp-controller="AuditLogs" asp-action="Index" title="Audit Monitor">
                    <i class="bi bi-shield-check text-danger"></i>
                    <span class="sidebar-link-text">Audit Monitor</span>
                </a>

@{
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var userName = User.Identity?.Name ?? "";
    var isUserAdmin = User.IsInRole("Admin") || User.IsInRole("Administrator") ||
                      string.Equals(userRole, "admin", StringComparison.OrdinalIgnoreCase) ||
                      userName.Contains("admin", StringComparison.OrdinalIgnoreCase);
    var displayRole = isUserAdmin ? "Admin" : (string.IsNullOrEmpty(userRole) ? "Employee" : userRole);
}

                @if (isUserAdmin)
                {
                    <a class="sidebar-link" asp-controller="Employees" asp-action="Permissions" title="User Roles & Permissions">
                        <i class="bi bi-key-fill text-warning"></i>
                        <span class="sidebar-link-text">Roles & Permissions</span>
                    </a>
                    <a class="sidebar-link" asp-controller="Employees" asp-action="Index" title="Staff Directory">
                        <i class="bi bi-people-fill text-info"></i>
                        <span class="sidebar-link-text">Staff Directory</span>
                    </a>
                }
            </nav>

            <div class="sidebar-footer">
                <div class="small text-secondary sidebar-brand-text">
                    <span>Enterprise v2.5</span>
                </div>
            </div>
        </aside>

        <!-- Main Wrapper -->
        <div class="main-wrapper">
            <!-- Top Sticky Header -->
            <header class="top-header">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn-sidebar-toggle" id="sidebarToggle" title="Toggle Navigation Sidebar">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                    <div class="d-none d-md-flex align-items-center gap-2 text-secondary small">
                        <i class="bi bi-shield-lock-fill text-primary"></i>
                        <span class="fw-semibold text-white">Enterprise Portal</span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="d-none d-xl-flex align-items-center gap-2 text-secondary small bg-dark bg-opacity-50 px-3 py-1.5 rounded-pill border border-secondary border-opacity-25">
                        <i class="bi bi-clock-fill text-primary"></i>
                        <span>@DateTime.UtcNow.ToString("MMM dd, yyyy HH:mm") UTC</span>
                    </div>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <button class="btn btn-glass dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 34px; height: 34px;">
                                    @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                </div>
                                <span class="d-none d-md-inline fw-semibold text-white">@User.Identity.Name</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end glass-card border border-secondary border-opacity-25 p-2 shadow-lg">
                                <li class="px-3 py-2 border-bottom border-secondary border-opacity-25">
                                    <div class="fw-bold text-white">@User.Identity.Name</div>
                                    <div class="small text-secondary mt-1">Role: <span class="badge @(isUserAdmin ? "bg-warning text-dark" : "bg-secondary text-white") fw-bold px-2 py-0.5">@displayRole</span></div>
                                </li>
                                <li>
                                    <form asp-controller="Auth" asp-action="Logout" method="post" class="mt-1">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger rounded-2 d-flex align-items-center gap-2">
                                            <i class="bi bi-box-arrow-right"></i> Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-glow btn-sm px-4">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Login
                        </a>
                    }
                </div>
            </header>

            <!-- Main Content Body -->
            <main role="main" class="py-4 flex-grow-1">
                <div class="container-fluid px-4">
                    @RenderBody()
                </div>
            </main>

            <!-- Footer -->
            <footer class="border-top border-secondary border-opacity-10 py-3 bg-dark bg-opacity-50 mt-auto">
                <div class="container-fluid px-4">
                    <div class="d-flex flex-column flex-md-row align-items-center justify-content-between text-secondary small gap-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-car-front-fill text-primary"></i>
                            <span>&copy; @DateTime.UtcNow.Year CarRental ERP Enterprise System. All rights reserved.</span>
                        </div>
                        <div class="d-flex gap-4">
                            <a href="#" class="text-secondary text-decoration-none">Privacy Policy</a>
                            <a href="#" class="text-secondary text-decoration-none">Terms of Service</a>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Data Grid Engine (DataTables / Kendo UI Integration) -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

    <script>
        $(document).ready(function() {
            const appWrapper = $('#appWrapper');
            const sidebarToggle = $('#sidebarToggle');

            // Restore Sidebar State from localStorage
            if (localStorage.getItem('sidebarCollapsed') === 'true') {
                appWrapper.addClass('sidebar-collapsed');
            }

            sidebarToggle.on('click', function() {
                appWrapper.toggleClass('sidebar-collapsed');
                const isCollapsed = appWrapper.hasClass('sidebar-collapsed');
                localStorage.setItem('sidebarCollapsed', isCollapsed);
            });

            // Highlight Active Link
            var currentPath = window.location.pathname.toLowerCase();
            $('.sidebar-link').each(function() {
                var href = $(this).attr('href');
                if (href && currentPath.indexOf(href.toLowerCase()) !== -1 && href !== '/') {
                    $(this).addClass('active');
                }
            });

            // Auto-initialize Enterprise Data Grids for all tables
            $('.table-futuristic').each(function() {
                if ($(this).find('tbody tr').length > 0 && !$(this).find('tbody tr td[colspan]').length) {
                    $(this).DataTable({
                        dom: '<"d-flex flex-column flex-md-row align-items-center justify-content-between mb-3 gap-2"Bf>rt<"d-flex flex-column flex-md-row align-items-center justify-content-between mt-3 gap-2"lip>',
                        buttons: [
                            { extend: 'copy', className: 'btn btn-sm' },
                            { extend: 'excel', className: 'btn btn-sm', title: 'ERP Data Export' },
                            { extend: 'pdf', className: 'btn btn-sm', title: 'ERP Data Export' },
                            { extend: 'print', className: 'btn btn-sm' }
                        ],
                        pageLength: 10,
                        lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                        language: {
                            search: "",
                            searchPlaceholder: "🔍 Fast Grid Search..."
                        },
                        responsive: true,
                        retrieve: true
                    });
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    @await Component.InvokeAsync("NToastNotify")
</body>
</html>