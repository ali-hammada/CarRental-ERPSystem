@using System.Globalization
@using Microsoft.AspNetCore.Localization
@inject Application.Providers.IDashboardProvider DashboardProvider
@inject Application.Providers.IAuditProvider AuditProvider
@inject Web.Services.ILocalizationService Loc

@{
    var currentUICulture = CultureInfo.CurrentUICulture.Name;
    var isArabic = currentUICulture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var isAuthPage = string.Equals(currentController, "Auth", StringComparison.OrdinalIgnoreCase);
    var isAuthenticated = User.Identity?.IsAuthenticated == true && !isAuthPage;

    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var userName = User.Identity?.Name ?? "";
    var isUserAdmin = User.IsInRole("Admin") || User.IsInRole("Administrator") ||
                      string.Equals(userRole, "admin", StringComparison.OrdinalIgnoreCase) ||
                      string.Equals(userRole, "administrator", StringComparison.OrdinalIgnoreCase) ||
                      userName.Contains("admin", StringComparison.OrdinalIgnoreCase);

    var isManager = isUserAdmin || string.Equals(userRole, "Manager", StringComparison.OrdinalIgnoreCase);
    var isAccountant = isUserAdmin || isManager || string.Equals(userRole, "Accountant", StringComparison.OrdinalIgnoreCase);
    var isHR = isUserAdmin || string.Equals(userRole, "HR", StringComparison.OrdinalIgnoreCase);
    var isEmployee = isUserAdmin || isManager || string.Equals(userRole, "Employee", StringComparison.OrdinalIgnoreCase);

    var displayRole = isUserAdmin ? "Admin" : (string.IsNullOrEmpty(userRole) ? "Employee" : userRole);

    int overdueCount = 0;
    int maintenanceCount = 0;
    int totalAlerts = 0;

    if (isAuthenticated)
    {
        var navMetrics = await DashboardProvider.GetDashboardMetricsAsync(isUserAdmin ? null : (int?)null);
        overdueCount = navMetrics?.OverdueRentalsCount ?? 0;
        maintenanceCount = navMetrics?.MaintenanceCarsCount ?? 0;
        totalAlerts = overdueCount + maintenanceCount;
    }
}

<!DOCTYPE html>
<html lang="@(isArabic ? "ar" : "en")" dir="@(isArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Enterprise CarRental ERP</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function () {
            var savedTheme = localStorage.getItem('appTheme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
</head>
<body class="@(!isAuthenticated ? "auth-mode" : "")">

    <div class="app-wrapper @(!isAuthenticated ? "auth-layout" : "")" id="appWrapper">
        @if (isAuthenticated)
        {
            <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
            <!-- Collapsible Glassmorphic Sidebar -->
            <aside class="sidebar-wrapper" id="sidebarMenu">
                <div class="sidebar-header">
                    <a class="sidebar-brand" asp-controller="Home" asp-action="Dashboard">
                        <div class="sidebar-brand-icon">
                            <i class="bi bi-car-front-fill"></i>
                        </div>
                        <span class="sidebar-brand-text text-gradient">CarRental<span class="text-white">ERP</span></span>
                    </a>
                </div>

                <nav class="sidebar-nav">
                    <a class="sidebar-link" asp-controller="Home" asp-action="Dashboard" title="@Loc.GetString("Dashboard")">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span class="sidebar-link-text">@Loc.GetString("Dashboard")</span>
                    </a>

                    @if (isUserAdmin || isManager || isEmployee)
                    {
                        <a class="sidebar-link" asp-controller="Car" asp-action="Index" title="@Loc.GetString("Rental Fleet Catalog")">
                            <i class="bi bi-car-front-fill"></i>
                            <span class="sidebar-link-text">@Loc.GetString("Rental Fleet Catalog")</span>
                        </a>
                        <a class="sidebar-link" asp-controller="Car" asp-action="SalesCatalog" title="@Loc.GetString("Sales Showroom")">
                            <i class="bi bi-shop text-warning"></i>
                            <span class="sidebar-link-text">@Loc.GetString("Sales Showroom")</span>
                        </a>
                        <a class="sidebar-link" asp-controller="Rentals" asp-action="Index" title="@Loc.GetString("Rental Contracts")">
                            <i class="bi bi-file-earmark-text-fill"></i>
                            <span class="sidebar-link-text">@Loc.GetString("Rental Contracts")</span>
                        </a>
                        <a class="sidebar-link" asp-controller="Sales" asp-action="Index" title="@Loc.GetString("Car Sales Ledger")">
                            <i class="bi bi-tag-fill text-success"></i>
                            <span class="sidebar-link-text">@Loc.GetString("Car Sales Ledger")</span>
                        </a>
                        <a class="sidebar-link" asp-controller="Rentals" asp-action="Calendar" title="Booking Calendar">
                            <i class="bi bi-calendar3 text-primary"></i>
                            <span class="sidebar-link-text">Booking Calendar</span>
                        </a>
                    }

                    @if (isUserAdmin || isManager)
                    {
                        <a class="sidebar-link" asp-controller="Car" asp-action="Alerts" title="Fleet Alerts Center">
                            <i class="bi bi-shield-exclamation text-warning"></i>
                            <span class="sidebar-link-text">Fleet Alerts</span>
                        </a>
                        <a class="sidebar-link" asp-controller="Sales" asp-action="Calculator" title="Installment Calculator">
                            <i class="bi bi-calculator text-success"></i>
                            <span class="sidebar-link-text">Amortization Calculator</span>
                        </a>
                    }

                    @if (isUserAdmin || isManager || isAccountant)
                    {
                        <a class="sidebar-link" asp-controller="Home" asp-action="FinancialReport" title="Executive Financial P&L">
                            <i class="bi bi-file-earmark-bar-graph text-info"></i>
                            <span class="sidebar-link-text">Financial P&L</span>
                        </a>
                    }

                    @if (isUserAdmin || isManager || isEmployee)
                    {
                        <a class="sidebar-link" asp-controller="Customers" asp-action="Index" title="@Loc.GetString("Customers")">
                            <i class="bi bi-people-fill"></i>
                            <span class="sidebar-link-text">@Loc.GetString("Customers")</span>
                        </a>
                    }

                    @if (isUserAdmin || isManager || isAccountant || isEmployee)
                    {
                        <a class="sidebar-link" asp-controller="Payment" asp-action="Index" title="@Loc.GetString("Payment Ledger")">
                            <i class="bi bi-wallet2"></i>
                            <span class="sidebar-link-text">@Loc.GetString("Payment Ledger")</span>
                        </a>
                        <a class="sidebar-link" asp-controller="Invoices" asp-action="Index" title="@Loc.GetString("Tax Invoices")">
                            <i class="bi bi-receipt-cutoff"></i>
                            <span class="sidebar-link-text">@Loc.GetString("Tax Invoices")</span>
                        </a>
                    }

                    @if (isUserAdmin || isManager || isEmployee)
                    {
                        <a class="sidebar-link" asp-controller="Maintenance" asp-action="Index" title="@Loc.GetString("Maintenance")">
                            <i class="bi bi-tools"></i>
                            <span class="sidebar-link-text">@Loc.GetString("Maintenance")</span>
                        </a>
                        <a class="sidebar-link" asp-controller="Tracking" asp-action="Index" title="@Loc.GetString("GPS Live Tracking")">
                            <i class="bi bi-broadcast text-primary"></i>
                            <span class="sidebar-link-text">@Loc.GetString("GPS Live Tracking")</span>
                        </a>
                    }

                    @if (isUserAdmin || isHR)
                    {
                        <a class="sidebar-link" asp-controller="AuditLogs" asp-action="Index" title="@Loc.GetString("Audit Monitor")">
                            <i class="bi bi-shield-check text-danger"></i>
                            <span class="sidebar-link-text">@Loc.GetString("Audit Monitor")</span>
                        </a>
                    }

                    @if (isUserAdmin || isHR)
                    {
                        <a class="sidebar-link" asp-controller="Employees" asp-action="Index" title="Staff Directory">
                            <i class="bi bi-people-fill text-info"></i>
                            <span class="sidebar-link-text">Staff Directory</span>
                        </a>
                    }

                    @if (isUserAdmin)
                    {
                        <a class="sidebar-link" asp-controller="Employees" asp-action="Permissions" title="@Loc.GetString("Roles & Permissions")">
                            <i class="bi bi-key-fill text-warning"></i>
                            <span class="sidebar-link-text">@Loc.GetString("Roles & Permissions")</span>
                        </a>
                    }
                </nav>

                <div class="sidebar-footer">
                    <div class="small text-secondary sidebar-brand-text">
                        <span>Enterprise v2.5</span>
                    </div>
                </div>
            </aside>
        }

        <div class="main-wrapper">
            @if (isAuthenticated)
            {
                <header class="top-header">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn-sidebar-toggle" id="sidebarToggle" title="Toggle Navigation Sidebar">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                    <div class="d-none d-md-flex align-items-center gap-2 text-secondary small">
                        <i class="bi bi-shield-lock-fill text-primary"></i>
                        <span class="fw-semibold text-white">@Loc.GetString("Enterprise Portal")</span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <!-- Multi-Language Selector Dropdown (English / العربية) -->
                    <div class="dropdown">
                        <button class="btn btn-glass d-flex align-items-center gap-1.5 px-3 py-1.5 rounded-pill" type="button" data-bs-toggle="dropdown" title="Select System Language">
                            <i class="bi bi-globe text-primary"></i>
                            <span class="small fw-bold text-white ms-1 d-none d-sm-inline">@(isArabic ? "العربية " : "English ")</span>
                            <i class="bi bi-chevron-down text-secondary ms-1" style="font-size: 0.7rem;"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-secondary border-opacity-25 mt-2">
                            <li>
                                <form asp-controller="Language" asp-action="SetLanguage" method="post" class="d-inline">
                                    <input type="hidden" name="culture" value="en-US" />
                                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                    <button type="submit" class="dropdown-item d-flex align-items-center justify-content-between py-2 @(!isArabic ? "active text-primary fw-bold" : "")">
                                        <span>🇺🇸 English (US)</span>
                                        @if (!isArabic) { <i class="bi bi-check-lg text-primary ms-2"></i> }
                                    </button>
                                </form>
                            </li>
                            <li><hr class="dropdown-divider my-1 border-secondary border-opacity-25"></li>
                            <li>
                                <form asp-controller="Language" asp-action="SetLanguage" method="post" class="d-inline">
                                    <input type="hidden" name="culture" value="ar-EG" />
                                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                    <button type="submit" class="dropdown-item d-flex align-items-center justify-content-between py-2 @(isArabic ? "active text-primary fw-bold" : "")">
                                        <span> العربية </span>
                                        @if (isArabic) { <i class="bi bi-check-lg text-primary ms-2"></i> }
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>

                    <!-- Futuristic Theme Switcher Toggle Button -->
                    <button class="theme-toggle-btn btn btn-glass d-flex align-items-center px-2 py-1.5 rounded-pill" id="themeToggleBtn" type="button" title="Switch Theme (Light / Dark Mode)">
                        <div class="theme-toggle-track">
                            <i class="bi bi-moon-stars-fill text-warning" style="font-size: 0.7rem;"></i>
                            <i class="bi bi-sun-fill text-warning" style="font-size: 0.7rem;"></i>
                            <div class="theme-toggle-thumb"></div>
                        </div>
                    </button>

                    <div class="d-none d-xl-flex align-items-center gap-2 text-secondary small bg-dark bg-opacity-50 px-3 py-1.5 rounded-pill border border-secondary border-opacity-25">
                        <i class="bi bi-clock-fill text-primary"></i>
                        <span id="liveHeaderClock" class="fw-bold text-white">@DateTime.Now.ToString("MMM dd, yyyy hh:mm tt")</span>
                    </div>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var recentAudits = await AuditProvider.GetRecentAuditLogsAsync(6);
                        var totalNotificationCount = totalAlerts + recentAudits.Count;

                        <!-- System Alerts & Employee Notifications Bell -->
                        <div class="dropdown">
                            <button class="btn btn-glass position-relative p-2" type="button" data-bs-toggle="dropdown" title="Live Employee Notifications & Operations Stream">
                                <i class="bi bi-bell-fill text-warning fs-5"></i>
                                @if (totalNotificationCount > 0)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">
                                        @totalNotificationCount
                                    </span>
                                }
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end glass-card border border-secondary border-opacity-25 p-3 shadow-lg" style="width: 360px; max-height: 480px; overflow-y: auto;">
                                <li class="d-flex align-items-center justify-content-between pb-2 mb-2 border-bottom border-secondary border-opacity-25">
                                    <span class="fw-bold text-white small"><i class="bi bi-bell-fill text-warning me-1"></i> Live Notifications & Audit Stream</span>
                                    <span class="badge bg-danger">@totalNotificationCount New</span>
                                </li>

                                @if (overdueCount > 0)
                                {
                                    <li class="mb-2">
                                        <a asp-controller="Rentals" asp-action="Index" class="dropdown-item text-wrap rounded p-2 bg-danger bg-opacity-10 border border-danger border-opacity-25">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-exclamation-octagon-fill text-danger fs-5"></i>
                                                <div>
                                                    <div class="fw-bold text-danger small">@overdueCount Overdue Contracts</div>
                                                    <div class="text-secondary small" style="font-size: 0.75rem;">Vehicle return dates exceeded</div>
                                                </div>
                                            </div>
                                        </a>
                                    </li>
                                }

                                @if (maintenanceCount > 0)
                                {
                                    <li class="mb-2">
                                        <a asp-controller="Maintenance" asp-action="Index" class="dropdown-item text-wrap rounded p-2 bg-warning bg-opacity-10 border border-warning border-opacity-25">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-tools text-warning fs-5"></i>
                                                <div>
                                                    <div class="fw-bold text-warning small">@maintenanceCount Vehicles in Maintenance</div>
                                                    <div class="text-secondary small" style="font-size: 0.75rem;">Currently out of active fleet</div>
                                                </div>
                                            </div>
                                        </a>
                                    </li>
                                }

                                <!-- Employee Live Actions Stream -->
                                @if (recentAudits.Any())
                                {
                                    <li class="px-1 py-1 text-secondary small fw-bold border-top border-secondary border-opacity-25 mt-2 pt-2">
                                        <i class="bi bi-person-workspace text-primary me-1"></i> Recent Employee Actions:
                                    </li>
                                    @foreach (var audit in recentAudits)
                                    {
                                        <li class="mb-1.5">
                                            <div class="dropdown-item text-wrap rounded p-2 bg-dark bg-opacity-60 border border-secondary border-opacity-25">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="fw-bold text-info small"><i class="bi bi-person-circle me-1"></i> @audit.EmployeeName</span>
                                                    <span class="text-secondary font-monospace" style="font-size: 0.68rem;">@audit.Timestamp.ToString("HH:mm")</span>
                                                </div>
                                                <div class="fw-semibold text-white small" style="font-size: 0.78rem;">@audit.Action (@audit.Module)</div>
                                                <div class="text-secondary small text-truncate" style="font-size: 0.72rem;" title="@audit.Details">@audit.Details</div>
                                            </div>
                                        </li>
                                    }
                                }

                                <li class="pt-2 mt-2 border-top border-secondary border-opacity-25 text-center">
                                    <a asp-controller="AuditLogs" asp-action="Index" class="text-primary text-decoration-none small fw-bold">
                                        View Full Audit Monitor Log <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-glass dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 34px; height: 34px;">
                                    @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                </div>
                                <span class="d-none d-md-inline fw-semibold text-white">@User.Identity.Name</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end glass-card border border-secondary border-opacity-25 p-2 shadow-lg">
                                <li class="px-3 py-2 border-bottom border-secondary border-opacity-25">
                                    <div class="fw-bold text-white">@User.Identity.Name</div>
                                    <div class="small text-secondary mt-1">Role: <span class="badge @(isUserAdmin ? "bg-warning text-dark" : "bg-secondary text-white") fw-bold px-2 py-0.5">@displayRole</span></div>
                                </li>
                                <li>
                                    <form asp-controller="Auth" asp-action="Logout" method="post" class="mt-1">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger rounded-2 d-flex align-items-center gap-2">
                                            <i class="bi bi-box-arrow-right"></i> Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-glow btn-sm px-4">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Login
                        </a>
                    }
                </div>
            </header>
            }

            <main role="main" class="@(isAuthenticated ? "py-4 flex-grow-1" : "flex-grow-1 d-flex flex-column")">
                <div class="@(isAuthenticated ? "container-fluid px-4" : "container-fluid p-0 flex-grow-1 d-flex flex-column")">
                    @RenderBody()
                </div>
            </main>

            @if (isAuthenticated)
            {
                <footer class="border-top border-secondary border-opacity-10 py-3 bg-dark bg-opacity-50 mt-auto">
                    <div class="container-fluid px-4">
                        <div class="d-flex flex-column flex-md-row align-items-center justify-content-between text-secondary small gap-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-car-front-fill text-primary"></i>
                                <span>&copy; @DateTime.UtcNow.Year CarRental ERP Enterprise System. All rights reserved.</span>
                            </div>
                            <div class="d-flex gap-4">
                                <a href="#" class="text-secondary text-decoration-none">Privacy Policy</a>
                                <a href="#" class="text-secondary text-decoration-none">Terms of Service</a>
                            </div>
                        </div>
                    </div>
                </footer>
            }
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

    <script>
        $(document).ready(function() {
            const appWrapper = $('#appWrapper');
            const sidebarToggle = $('#sidebarToggle');

            if (localStorage.getItem('sidebarCollapsed') === 'true') {
                appWrapper.addClass('sidebar-collapsed');
            }

            sidebarToggle.on('click', function() {
                if ($(window).width() <= 768) {
                    appWrapper.toggleClass('sidebar-mobile-open');
                } else {
                    appWrapper.toggleClass('sidebar-collapsed');
                    const isCollapsed = appWrapper.hasClass('sidebar-collapsed');
                    localStorage.setItem('sidebarCollapsed', isCollapsed);
                }
            });

            $('#sidebarBackdrop').on('click', function() {
                appWrapper.removeClass('sidebar-mobile-open');
            });

            var currentPath = window.location.pathname.toLowerCase();
            $('.sidebar-link').each(function() {
                var href = $(this).attr('href');
                if (href && currentPath.indexOf(href.toLowerCase()) !== -1 && href !== '/') {
                    $(this).addClass('active');
                }
            });

            var isAr = document.documentElement.getAttribute('dir') === 'rtl';
            var dtLanguage = isAr ? {
                search: "",
                searchPlaceholder: "🔍 بحث سريع في السجلات...",
                lengthMenu: "عدد السطور في الصفحة: _MENU_",
                info: "عرض _START_ - _END_ من إجمالي _TOTAL_ عنصر",
                infoEmpty: "لا توجد عناصر لعرضها",
                infoFiltered: "(مفلترة من إجمالي _MAX_ عنصر)",
                zeroRecords: "لم يتم العثور على سجلات مطابقة",
                paginate: {
                    first: "«",
                    previous: "‹",
                    next: "›",
                    last: "»"
                }
            } : {
                search: "",
                searchPlaceholder: "🔍 Fast Grid Search...",
                lengthMenu: "Show _MENU_ entries per page",
                info: "Showing _START_ - _END_ of _TOTAL_ entries",
                infoEmpty: "Showing 0 to 0 of 0 entries",
                infoFiltered: "(filtered from _MAX_ total entries)",
                zeroRecords: "No matching records found",
                paginate: {
                    first: "«",
                    previous: "‹",
                    next: "›",
                    last: "»"
                }
            };

            var btnCopy = isAr ? "📋 نسخ" : "Copy";
            var btnExcel = isAr ? "📊 إكسيل" : "Excel";
            var btnPdf = isAr ? "📄 PDF" : "PDF";
            var btnPrint = isAr ? "🖨️ طباعة" : "Print";

            $('.table-futuristic').each(function() {
                if ($(this).find('tbody tr').length > 0 && !$(this).find('tbody tr td[colspan]').length) {
                    $(this).DataTable({
                        order: [[0, 'desc']],
                        dom: '<"d-flex flex-column flex-md-row align-items-center justify-content-between mb-3 gap-2"Bf>rt<"d-flex flex-column flex-md-row align-items-center justify-content-between mt-3 gap-2"lip>',
                        buttons: [
                            { extend: 'copy', text: btnCopy, className: 'btn btn-sm btn-glass px-3' },
                            { extend: 'excel', text: btnExcel, className: 'btn btn-sm btn-glass px-3', title: 'ERP Data Export' },
                            { extend: 'pdf', text: btnPdf, className: 'btn btn-sm btn-glass px-3', title: 'ERP Data Export' },
                            { extend: 'print', text: btnPrint, className: 'btn btn-sm btn-glass px-3' }
                        ],
                        pageLength: 10,
                        lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, isAr ? "الكل" : "All"]],
                        language: dtLanguage,
                        responsive: true,
                        retrieve: true
                    });
                }
            });

            function updateThemeUI(theme) {
                document.documentElement.setAttribute('data-theme', theme);
                localStorage.setItem('appTheme', theme);
            }

            var currentTheme = localStorage.getItem('appTheme') || 'dark';
            updateThemeUI(currentTheme);

            $('#themeToggleBtn').on('click', function () {
                var activeTheme = document.documentElement.getAttribute('data-theme') || 'dark';
                var newTheme = (activeTheme === 'dark') ? 'light' : 'dark';
                updateThemeUI(newTheme);
            });
        });
    </script>

    @if (isAuthenticated)
    {
        <div id="liveAdminToastContainer" class="live-toast-container"></div>

        <script>
            document.addEventListener('DOMContentLoaded', function () {
                let lastSeenAuditId = parseInt(localStorage.getItem('last_seen_audit_id') || '0');

                function showLiveToast(audit) {
                    const container = document.getElementById('liveAdminToastContainer');
                    if (!container) return;

                    const toast = document.createElement('div');
                    toast.className = 'live-toast-card';
                    toast.innerHTML = `
                        <div class="d-flex align-items-start justify-content-between gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle bg-primary bg-opacity-25 text-primary p-2 fs-5 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                    <i class="bi bi-bell-fill"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-white small"><i class="bi bi-person-circle text-info me-1"></i> ${audit.employeeName}</div>
                                    <div class="fw-semibold text-gradient small">${audit.action} (${audit.module})</div>
                                </div>
                            </div>
                            <button type="button" class="btn-close btn-close-white small" onclick="this.closest('.live-toast-card').remove();"></button>
                        </div>
                        <div class="mt-2 text-secondary small text-truncate" style="font-size: 0.78rem;" title="${audit.details}">
                            ${audit.details}
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-secondary border-opacity-25" style="font-size: 0.7rem;">
                            <span class="text-secondary"><i class="bi bi-clock me-1"></i> ${audit.time}</span>
                            <a href="/AuditLogs/Index" class="text-primary text-decoration-none fw-bold">View Log →</a>
                        </div>
                    `;

                    container.appendChild(toast);

                    // Auto-remove toast after 8 seconds
                    setTimeout(() => {
                        if (toast && toast.parentNode) {
                            toast.style.opacity = '0';
                            toast.style.transform = 'translateY(-10px)';
                            setTimeout(() => toast.remove(), 300);
                        }
                    }, 8000);
                }

                function pollNewAudits() {
                    fetch('/AuditLogs/GetLatestAudit')
                        .then(res => res.json())
                        .then(data => {
                            if (data && data.id) {
                                if (lastSeenAuditId > 0 && data.id > lastSeenAuditId) {
                                    showLiveToast(data);
                                }
                                lastSeenAuditId = data.id;
                                localStorage.setItem('last_seen_audit_id', lastSeenAuditId);
                            }
                        })
                        .catch(() => {});
                }

                pollNewAudits();
                setInterval(pollNewAudits, 4000);

                function updateHeaderClock() {
                    const clockEl = document.getElementById('liveHeaderClock');
                    if (clockEl) {
                        const now = new Date();
                        const isAr = document.documentElement.getAttribute('dir') === 'rtl';
                        clockEl.textContent = now.toLocaleString(isAr ? 'ar-EG' : 'en-US', {
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit',
                            second: '2-digit',
                            hour12: true
                        });
                    }
                }
                updateHeaderClock();
                setInterval(updateHeaderClock, 1000);
            });
        </script>
    }

    <script>
        function submitFormViaAjax(formElement, onSuccess) {
            var $form = $(formElement);
            var formData = new FormData(formElement);
            var $alert = $form.find('.ajax-error-alert');
            if ($alert.length === 0) {
                $alert = $('<div class="alert alert-danger ajax-error-alert mt-3" style="display:none;"></div>');
                $form.prepend($alert);
            }
            $alert.hide().empty();

            var $submitBtn = $form.find('button[type="submit"]');
            var originalBtnHtml = $submitBtn.html();
            $submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Processing...');

            $.ajax({
                url: $form.attr('action'),
                type: $form.attr('method') || 'POST',
                data: formData,
                contentType: false,
                processData: false,
                headers: { "X-Requested-With": "XMLHttpRequest" },
                success: function(response) {
                    $submitBtn.prop('disabled', false).html(originalBtnHtml);
                    if (response.success) {
                        if (onSuccess) {
                            onSuccess(response);
                        } else if (response.redirectUrl) {
                            window.location.href = response.redirectUrl;
                        } else {
                            window.location.reload();
                        }
                    } else {
                        var msg = response.message || "An error occurred.";
                        $alert.html('<i class="bi bi-exclamation-triangle-fill me-2"></i>' + msg).slideDown();
                    }
                },
                error: function(xhr) {
                    $submitBtn.prop('disabled', false).html(originalBtnHtml);
                    var msg = "An unexpected server error occurred.";
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        msg = xhr.responseJSON.message;
                    }
                    $alert.html('<i class="bi bi-exclamation-triangle-fill me-2"></i>' + msg).slideDown();
                }
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>