@model ApplicationCore.Entities.Invoice

@{
    ViewData["Title"] = "Tax Invoice #" + Model.InvoiceNumber;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="glass-card p-5" id="printableInvoice">
            <!-- Invoice Header -->
            <div class="d-flex justify-content-between align-items-start border-bottom border-secondary border-opacity-25 pb-4 mb-4">
                <div>
                    <h3 class="fw-extrabold text-gradient mb-1">CarRental ERP Enterprise</h3>
                    <p class="text-secondary small mb-0">Official Tax Invoice (14% VAT)</p>
                    <p class="text-secondary small">TRN: 849201948-VAT</p>
                </div>
                <div class="text-end">
                    <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25 fs-6 px-3 py-2">
                        @Model.InvoiceNumber
                    </span>
                    <div class="text-secondary small mt-2">Issued Date: @Model.IssueDate.ToString("MMMM dd, yyyy")</div>
                </div>
            </div>

            <!-- Rental Contract Reference -->
            <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25 mb-4">
                <div class="row">
                    <div class="col-md-6">
                        <div class="text-secondary small">Associated Rental Contract</div>
                        <div class="fw-bold text-white fs-5">#CNT-@Model.RentalContractId.ToString("D5")</div>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <div class="text-secondary small">Status</div>
                        <div class="fw-bold text-success">@Model.Status</div>
                    </div>
                </div>
            </div>

            <!-- Tax Invoice Financial Table -->
            <div class="table-responsive mb-4">
                <table class="table table-futuristic align-middle">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th class="text-end">Rate / Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Rental Usage SubTotal</td>
                            <td class="text-end fw-semibold text-white">@Model.SubTotal.ToString("C")</td>
                        </tr>
                        @if (Model.ExtraFees > 0)
                        {
                            <tr>
                                <td>Additional Services & Fees</td>
                                <td class="text-end fw-semibold text-warning">@Model.ExtraFees.ToString("C")</td>
                            </tr>
                        }
                        <tr>
                            <td>Value Added Tax (14% VAT)</td>
                            <td class="text-end fw-semibold text-warning">@Model.TaxAmount.ToString("C")</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="border-top border-secondary border-opacity-50">
                            <td class="fs-5 fw-bold text-white">Grand Total Amount</td>
                            <td class="text-end fs-4 fw-extrabold text-gradient-emerald">@Model.TotalAmount.ToString("C")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Actions Footer -->
            <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary border-opacity-25 no-print">
                <a asp-action="Index" class="btn btn-glass">
                    <i class="bi bi-arrow-left me-1"></i> Back to Invoices
                </a>
                <button onclick="window.print()" class="btn btn-glow px-4">
                    <i class="bi bi-printer me-1"></i> Print Tax Invoice
                </button>
            </div>
        </div>
    </div>
</div>
