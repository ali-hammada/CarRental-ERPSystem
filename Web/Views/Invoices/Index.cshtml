@model IEnumerable<ApplicationCore.Entities.Invoice>

@{
    ViewData["Title"] = "Tax Invoices & Financial Ledger";
}

<div class="d-flex flex-column gap-4">
    <!-- Header Banner -->
    <div class="glass-card p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1">
                    <i class="bi bi-receipt-cutoff me-1"></i> Tax Invoice Registry
                </span>
                <span class="text-secondary small">Total Issued Invoices: @Model.Count()</span>
            </div>
            <h2 class="fw-extrabold mb-0 text-white">Tax Invoices (14% VAT)</h2>
        </div>
    </div>

    <!-- Invoices Table Card -->
    <div class="glass-card p-4">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-secondary">
                <i class="bi bi-receipt fs-1 d-block mb-3 text-muted"></i>
                <h4 class="text-white fw-bold">No tax invoices generated</h4>
                <p class="mb-4">Tax invoices are generated automatically when rental contracts are created.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-futuristic align-middle">
                    <thead>
                        <tr>
                            <th>Invoice #</th>
                            <th>Contract ID</th>
                            <th>Issue Date</th>
                            <th>SubTotal</th>
                            <th>VAT Tax (14%)</th>
                            <th>Total Amount</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@invoice.Id" class="fw-bold text-gradient text-decoration-none">
                                        @invoice.InvoiceNumber
                                    </a>
                                </td>
                                <td>
                                    <a asp-controller="Rentals" asp-action="Details" asp-route-rentalId="@invoice.RentalContractId" class="text-primary fw-semibold text-decoration-none">
                                        #CNT-@invoice.RentalContractId.ToString("D5")
                                    </a>
                                </td>
                                <td><span class="text-secondary small">@invoice.IssueDate.ToString("MMM dd, yyyy")</span></td>
                                <td><span class="fw-semibold text-white">@invoice.SubTotal.ToString("C")</span></td>
                                <td><span class="fw-semibold text-warning">@invoice.TaxAmount.ToString("C")</span></td>
                                <td><span class="fw-extrabold text-success">@invoice.TotalAmount.ToString("C")</span></td>
                                <td>
                                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 px-3 py-1">
                                        @invoice.Status
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@invoice.Id" class="btn btn-glass btn-sm">
                                        <i class="bi bi-eye me-1"></i> View Invoice
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
